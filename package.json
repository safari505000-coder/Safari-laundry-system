{
  "name": "safari-erp",
  "version": "1.5.5",
  "description": "Safari Fast Group ERP — NestJS API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "//api-run": "Dev API: `npm run dev` or `npm run start:dev` (Nest --watch). Avoid `npm run start dev` — npm runs the `start` script only and still executes `node dist/main.js` (extra `dev` is a useless argv for Node), so you can hit stale dist and Express `Cannot GET` on new routes. Use `npm run dist:start` for build+migrate+seed+dist.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/pre-deploy.mjs && npx prisma migrate deploy && npx prisma db seed && node dist/main.js",
    "dist:start": "npm run build && npx prisma migrate deploy && npx prisma db seed && node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:accountant-dashboard-integration": "jest finance/services/accountant-dashboard.integration.spec.ts --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "db:check-drift": "tsx scripts/check-migration-drift.ts",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "db:reset-invoices": "tsx scripts/reset-invoices.ts",
    "db:reset-money": "tsx scripts/reset-invoices.ts --confirm=DELETE-INVOICES-AND-MONEY",
    "db:reset-local": "tsx scripts/reset-invoices.ts --confirm=DELETE-LOCAL-TEST-ALL",
    "db:wipe-operational": "tsx scripts/reset-invoices.ts --confirm=DELETE-OPERATIONAL-DATA",
    "db:truncate-financial": "tsx scripts/truncate-financial-data.ts",
    "db:truncate-financial:execute": "tsx scripts/truncate-financial-data.ts --confirm=TRUNCATE-FINANCIAL-DATA",
    "financial:reset": "tsx scripts/financial-reset.ts",
    "db:backup-desktop": "tsx scripts/backup-db-to-desktop.ts",
    "seed:price-list": "tsx scripts/seed-price-list.ts",
    "apply-payroll-roster-order": "tsx scripts/apply-payroll-roster-order.ts",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "public-web:dev": "npm run dev --prefix apps/public-web",
    "public-web:build": "npm run build --prefix apps/public-web",
    "employee-mobile:start": "npm run start --prefix apps/employee-mobile",
    "employee-mobile:android": "npm run android --prefix apps/employee-mobile",
    "employee-mobile:ios": "npm run ios --prefix apps/employee-mobile",
    "employee-mobile:typecheck": "npm run typecheck --prefix apps/employee-mobile",
    "customer-mobile:start": "npm run start --prefix apps/customer-mobile",
    "customer-mobile:android": "npm run android --prefix apps/customer-mobile",
    "customer-mobile:ios": "npm run ios --prefix apps/customer-mobile",
    "customer-mobile:typecheck": "npm run typecheck --prefix apps/customer-mobile",
    "customer-mobile:test:logic": "npm run test:logic --prefix apps/customer-mobile",
    "customer-mobile:build:android": "npm run build:android --prefix apps/customer-mobile",
    "customer-mobile:build:ios": "npm run build:ios --prefix apps/customer-mobile",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/safety-check.ps1 full",
    "check:precommit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/safety-check.ps1 precommit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1040.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.74.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sentry/node": "^10.49.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.14.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": [
      "<rootDir>/test/setup/jest-node-env.ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
