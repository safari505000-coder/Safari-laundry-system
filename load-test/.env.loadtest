DATABASE_URL=postgresql://postgres@localhost:5432/safari_loadtest
OPERATING_HOURS_LOCK_ENABLED=false
PAYMENTS_MOCK=true
PUBLIC_API_URL=http://localhost:3001
PUBLIC_WEB_APP_URL=http://localhost:5178
JWT_SECRET=loadtest-secret-not-for-prod-c7e3a91b4f2e8d5a
PORT=3001
NODE_ENV=production
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
AUTH_BYPASS_WORKING_HOURS=1

# --- V19.12 perf tuning (loadtest only) ---
# bcrypt: 10 rounds, ~6 worker threads (covers 12-core dev box)
BCRYPT_ROUNDS=10
# 24-core box — keep 4 for event loop / Prisma, give 20 to bcrypt.
BCRYPT_WORKERS=20
# Loadtest funnels every VU through 127.0.0.1; the default 5/min/IP login
# throttle would pre-empt the workload under test. Turn the per-route budget
# off and keep the global throttler ceiling disabled.
AUTH_LOGIN_THROTTLE_LIMIT=1000000
AUTH_LOGIN_THROTTLE_TTL_MS=60000
THROTTLE_GLOBAL_LIMIT=0
# Short access tokens mirror production defaults. Loadtest doesn't use refresh.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=7
# Give libuv enough threads for any residual sync bcrypt callers.
UV_THREADPOOL_SIZE=16
