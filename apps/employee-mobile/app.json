{
  "expo": {
    "name": "Safari ERP Staff",
    "slug": "safari-erp-staff",
    "scheme": "safari-erp-staff",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "version": "0.1.0",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نحتاج موقعك لتتبع مهام التوصيل."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج الكamera لمسح باركود الفاتورة."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api",
      "router": {
        "origin": false
      }
    }
  }
}
