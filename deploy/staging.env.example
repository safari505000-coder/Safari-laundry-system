# V11.0 — Staging / demo (copy into your host’s environment; do not commit secrets).
# Production domain in this repo is safariomni.com — staging URL is assigned by your provider (Render, VPS, etc.).

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=8080
NODE_ENV=production

# Same-origin SPA + API: set PUBLIC_WEB_APP_URL to the staging origin you publish (see docs/STAGING_V11.md).
# CORS_ORIGIN must include that origin.
CORS_ORIGIN=https://YOUR-STAGING-HOST.example
PUBLIC_API_URL=https://YOUR-STAGING-HOST.example
PUBLIC_WEB_APP_URL=https://YOUR-STAGING-HOST.example
PAYMENTS_CALLBACK_PUBLIC_URL=https://YOUR-STAGING-HOST.example

# V11 — Pause Google Cloud Storage on staging: receipts & DB backup dumps stay under ./uploads on the server.
STORAGE_DRIVER=local
# Omit GOOGLE_APPLICATION_CREDENTIALS and GCS_BUCKET unless testing the vault.

# One-time after importing old test data: force canonical V8.5 payment fee rows on seed, then remove.
# SEED_FORCE_CANONICAL_FEES=true
