# Copy these into Render -> Preview Environment (for PR previews).
# Required for API startup:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PORT=8080
NODE_ENV=production

# Domain + CORS:
CORS_ORIGIN=https://safariomni.com,https://www.safariomni.com
PUBLIC_API_URL=https://safariomni.com
PUBLIC_WEB_APP_URL=https://safariomni.com
PAYMENTS_CALLBACK_PUBLIC_URL=https://safariomni.com

# Optional for preview stability (disable strict lock window if needed):
# OPERATING_HOURS_LOCK_ENABLED=false

