# Copy these into your Render Web Service → Environment (production).
# No trailing slashes on URLs.
#
# If logs show: "Mock payment link" or "Moatmt: MOATMT_INSTANCE_ID… empty"
# the variables below are not set in the dashboard — add UPayments + Moatmt
# secrets, save, and redeploy.
CORS_ORIGIN=https://safariomni.com,https://www.safariomni.com
PUBLIC_API_URL=https://safariomni.com
# Use apex or www consistently with your SPA redirect; include both in CORS_ORIGIN.
PUBLIC_WEB_APP_URL=https://www.safariomni.com
PAYMENTS_CALLBACK_PUBLIC_URL=https://safariomni.com

# --- UPayments (production) ---
# UPayments live endpoint is apiv2api.upayments.com (NOT api.upayments.com,
# which is the merchant dashboard and returns 404 for /api/v1/charge).
# Switch to https://sandboxapi.upayments.com while testing with a
# sandbox API key, then flip back to apiv2api.upayments.com for live.
PAYMENTS_API_BASE_URL=https://apiv2api.upayments.com
PAYMENTS_MERCHANT_ID=73541
# Set PAYMENTS_API_KEY in the Render dashboard (secret).
# Set PAYMENTS_SECRET in the Render dashboard (optional for UPayments;
# required only if a non-UPayments gateway is ever wired to /payments/callback).

# --- Moatmt (WhatsApp) — https://moatmt.sa/api/send ---
# MOATMT_API_BASE_URL=https://moatmt.sa/api
# MOATMT_INSTANCE_ID=69EA9EB3C8D51
# Set MOATMT_ACCESS_TOKEN in Render (secret).

# --- Operating hours (Kuwait) — middleware blocks POST/PUT/PATCH outside window when lock is on ---
# Default in code: lock ON if this variable is unset. To open API 24/7 temporarily, set in Render:
#   OPERATING_HOURS_LOCK_ENABLED=false
# (or 0). Re-set to true when you want the business window again. Optional window when lock is on:
# OPERATING_HOURS_KUWAIT_START_HOUR=7
# OPERATING_HOURS_KUWAIT_END_HOUR=23
