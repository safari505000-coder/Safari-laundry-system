# Copy these into your Render Web Service → Environment (production).
# No trailing slashes on URLs.
CORS_ORIGIN=https://safariomni.com,https://www.safariomni.com
PUBLIC_API_URL=https://safariomni.com
PUBLIC_WEB_APP_URL=https://safariomni.com
PAYMENTS_CALLBACK_PUBLIC_URL=https://safariomni.com

# --- UPayments (production) ---
# UPayments live endpoint is apiv2api.upayments.com (NOT api.upayments.com,
# which is the merchant dashboard and returns 404 for /api/v1/charge).
# Switch to https://sandboxapi.upayments.com while testing with a
# sandbox API key, then flip back to apiv2api.upayments.com for live.
PAYMENTS_API_BASE_URL=https://apiv2api.upayments.com
PAYMENTS_MERCHANT_ID=73541
# Set PAYMENTS_API_KEY in the Render dashboard (secret).
# Set PAYMENTS_SECRET in the Render dashboard (optional for UPayments;
# required only if a non-UPayments gateway is ever wired to /payments/callback).

# --- Infobip SMS (invoice + payment link text) ---
# Set in Render secrets: INFOBIP_API_KEY. Subdomain from portal: Base URL for API.
# INFOBIP_BASE_URL=https://YOUR_SUBDOMAIN.api.infobip.com
# INFOBIP_SMS_FROM=Registered sender name/number in Infobip
