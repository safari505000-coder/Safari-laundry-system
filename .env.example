# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# JWT
JWT_SECRET=change-me

# CORS (comma-separated origins)
# CORS_ORIGIN=http://localhost:5173

# --- Kuwait Gateway / Payments (hosted payment link + webhook) ---
# Base URL of the payment provider API (no trailing slash). Required for PAYMENT_LINK checkout.
PAYMENTS_API_BASE_URL=

# API credentials (from your gateway dashboard)
PAYMENTS_API_KEY=
PAYMENTS_MERCHANT_ID=

# Shared secret: (1) outbound request signing, (2) verify webhook signature
# Callback body signature = hex(HMAC-SHA256(PAYMENTS_SECRET, `${orderId}|${status}|${amount}`))
PAYMENTS_SECRET=

# Public HTTPS base URL of THIS backend (no trailing slash), used to build callback URL for the gateway:
#   {PAYMENTS_CALLBACK_PUBLIC_URL}/api/payments/callback
PAYMENTS_CALLBACK_PUBLIC_URL=

# Fallback if PAYMENTS_CALLBACK_PUBLIC_URL is unset (e.g. local dev)
PUBLIC_API_URL=http://localhost:3000

# --- Operating hours (Kuwait) — blocks POST/PUT/PATCH outside window for API clients ---
# Set to false to disable (e.g. local dev).
OPERATING_HOURS_LOCK_ENABLED=true
OPERATING_HOURS_KUWAIT_START_HOUR=7
OPERATING_HOURS_KUWAIT_END_HOUR=23

# --- Customer SMS / WhatsApp (async after POS invoice) ---
# Optional webhook: POST JSON { to, message, orderId, template }
CUSTOMER_NOTIFY_WEBHOOK_URL=
# Public web app URL for “view order” links in SMS (no trailing slash)
PUBLIC_WEB_APP_URL=http://localhost:5173
