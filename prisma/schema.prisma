// Safari Fast Group — PostgreSQL schema (UUID PKs). Migrations not applied yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * Institutional roles — enforced in app, permissions, and JWT guards.
 */
enum SafariRole {
  OWNER
  GENERAL_MANAGER
  MANAGER
  DRIVER
  WORKER
  CALL_CENTER
  // V19.9 — Call Center Supervisor (مسؤول الكول سنتر). Inherits every
  // CALL_CENTER capability PLUS same-day invoice edit/void with an
  // immutable audit trail and access to CC agent performance reports.
  // Every guard that accepts CALL_CENTER MUST also accept this role.
  CALL_CENTER_SUPERVISOR
  // V19.10 — Fleet Supervisor (مسؤول السيارات). Logs vehicle fuel /
  // repair / maintenance expenses with a MANDATORY receipt photo; every
  // row starts at PENDING_ACCOUNTANT and only the Accountant (with
  // OWNER / GM as audit viewers) can approve or reject. Reporting
  // surfaces aggregate by vehicle, expense type, and month for OWNER +
  // ACCOUNTANT oversight.
  FLEET_SUPERVISOR
  ACCOUNTANT
  SUPERVISOR
  VIEWER
}

enum OrderStatus {
  PENDING
  PICKED_UP
  IN_PROGRESS
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELED
}

// V19.9 — Invoice audit trail actions. Every EDIT or VOID by a Call-
// Center Supervisor writes one immutable InvoiceAuditLog row capturing
// the before/after snapshot and the actor. The report surface (Owner /
// GM / Accountant) reads from this table exclusively.
enum InvoiceAuditAction {
  EDIT
  VOID
}

enum ServiceType {
  EXPRESS
  NORMAL
}

/**
 * Cash custody for completed COD-style orders.
 */
enum CashStatus {
  UNPAID
  PAID_TO_DRIVER
  HANDED_OVER_TO_OFFICE
  // V19.11.3 — POS paid with KNET: the money never sits with the driver
  // and never needs a manager handover. Terminal-settled electronically,
  // already posted as POS_SALE_COMPLETED with posPaymentMethod=KNET.
  PAID_ONLINE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum LedgerTransactionType {
  SUBSCRIPTION_ACTIVATION
  ORDER_WALLET_SETTLEMENT
}

/**
 * V19.4 — CC pack #2/#11/#12. Lifecycle of an individual subscription
 * instance (distinct from the plan catalogue entry). Each row in
 * `CustomerSubscription` walks through these states linearly:
 * ACTIVE        activatedAt set, expiresAt in future, current wallet plan
 * EXPIRED       expiresAt passed, never rolled over nor cancelled
 * ROLLED_OVER   replaced by a newer activation; balance carried forward
 * (positive = credit carried, negative = debt carried)
 * CUT_OFF       operator-closed after a non-payment policy trigger
 * CANCELLED     administrative cancellation (refund / fraud / duplicate)
 * No state skips directly back to ACTIVE — a new row is always created.
 */
enum CustomerSubscriptionStatus {
  ACTIVE
  EXPIRED
  ROLLED_OVER
  CUT_OFF
  CANCELLED
}

/**
 * POS / daily sales — how the non-wallet portion was collected (if any).
 */
enum PosPaymentMethod {
  SUBSCRIPTION_WALLET
  CASH
  KNET
  PAYMENT_LINK
  DEBT_ON_ACCOUNT
  ONLINE
}

enum StarchOption {
  NONE
  STARCH_25
}

/**
 * V19.11 — DebtLedgerEntry is the unified accounting book:
 * • SUBSCRIPTION_OVERUSE, INVOICE_SHORTFALL  (+) debt created
 * • PAYMENT                                  (−) debt settled
 * `amount` is ALWAYS a positive decimal. The sign is implied by the
 * source (creation vs settlement). The "open" balance per order /
 * customer is therefore:
 * SUM(INVOICE_SHORTFALL + SUBSCRIPTION_OVERUSE) − SUM(PAYMENT)
 * The table is append-only by convention and enforced at the service
 * layer (a Prisma middleware rejects update / delete / deleteMany).
 */
enum DebtSource {
  SUBSCRIPTION_OVERUSE
  INVOICE_SHORTFALL
  PAYMENT
}

enum DebtEntityCategory {
  BRANCH
  DRIVER
  OWNER
  CALL_CENTER
}

/**
 * Manager shift-end bank paperwork for accountant reconciliation.
 */
enum BankDepositType {
  CASH_DEPOSIT_SLIP
  KNET_Z_REPORT
}

enum DepositType {
  CASH
  KNET
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Dastur §2.MANAGER / §3 — Manager custody aging.
 * Lifecycle of a cash "bag" a Branch Manager receives from a Driver:
 * PENDING_DEPOSIT      → received from driver, no bank slip yet (24h clock runs)
 * AWAITING_VERIFICATION → manager uploaded slip, accountant to verify
 * VERIFIED             → accountant approved, custody closed
 * REJECTED             → accountant rejected slip, back under manager liability
 */
/**
 * Dastur §5 — Debt transfer workflow states.
 * DRAFT               → created by GM/ACCOUNTANT, still editable
 * AWAITING_SIGNATURES → submitted, waiting on both driver signatures
 * COMPLETED           → both signed + finalized (orders reassigned + GL posted)
 * CANCELLED           → voided before finalization
 */
enum DebtTransferStatus {
  DRAFT
  AWAITING_SIGNATURES
  COMPLETED
  CANCELLED
}

enum ManagerCashCustodyStatus {
  PENDING_DEPOSIT
  AWAITING_VERIFICATION
  VERIFIED
  REJECTED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /**
   * Unique login handle (staff ID / username).
   */
  username          String     @unique
  password          String
  fullName          String
  /**
   * Legacy corporate employee number (optional).
   */
  employeeId        String?    @unique
  /**
   * Legacy job title (optional).
   */
  jobTitle          String?
  phone             String?    @unique
  /**
   * Optional vehicle display label for tracking UI (e.g. Toyota LC300).
   */
  vehicleLabel      String?
  /**
   * Last GPS point as "lat,lng".
   */
  lastKnownLocation String?
  /**
   * Dastur §1 (V1.5) — Owner-assigned single-letter prefix for drivers
   * ("A", "B", ...). Combined with the global SerialCounter to stamp
   * every outgoing order with a human-readable serial like "A-1042".
   * Optional: non-driver users never receive one.
   */
  driverPrefix      String?    @unique
  safariRole        SafariRole @default(DRIVER)
  /**
   * Owner toggle: inactive users cannot sign in.
   */
  isActive          Boolean    @default(true)
  roleId            String     @db.Uuid
  branchId          String?    @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // ─── HR master-data (Stage D) ─────────────────────────────────────
  /**
   * /**
   * /**
   * /** Kuwaiti Civil ID — البطاقة المدنية.
   */
  civilId            String?   @unique
  nationality        String?
  address            String?
  bankName           String?
  /**
   * IBAN for salary transfers.
   */
  bankIban           String?
  hireDate           DateTime?
  /**
   * Monthly basic salary used to seed new payroll rows.
   */
  basicMonthlySalary Decimal?  @db.Decimal(19, 4)
  /**
   * Fixed monthly allowances (housing, transport, etc.) used to seed payroll.
   */
  monthlyAllowances  Decimal?  @db.Decimal(19, 4)

  role                             Role                   @relation(fields: [roleId], references: [id])
  branch                           Branch?                @relation(fields: [branchId], references: [id])
  auditLogs                        AuditLog[]
  ordersAsDriver                   Order[]                @relation("OrderDriver")
  shiftsAsDriver                   Shift[]                @relation("ShiftDriver")
  shiftConfirmations               Shift[]                @relation("ShiftConfirmedBy")
  ledgerTransactions               TransactionHistory[]   @relation("LedgerPerformedBy")
  expensesRecorded                 BranchExpense[]        @relation("ExpenseRecordedBy")
  payrolls                         Payroll[]
  debtLedgerEntries                DebtLedgerEntry[]      @relation("DebtEntryActor")
  bankDepositsUploaded             BankDepositLog[]       @relation("BankDepositUploadedBy")
  bankDepositsVerifiedAsAccountant BankDepositLog[]       @relation("BankDepositVerifiedBy")
  depositsRequested                Deposit[]              @relation("DepositDriver")
  depositsAudited                  Deposit[]              @relation("DepositAuditedBy")
  posPaymentBundlesLed             PosPaymentBundle[]     @relation("PosPaymentBundleDriver")
  stockMovementsRecorded           StockMovement[]        @relation("StockMovementRecordedBy")
  purchaseOrdersCreated            PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved           PurchaseOrder[]        @relation("PurchaseOrderApprovedBy")
  purchaseOrderReceipts            PurchaseOrderReceipt[] @relation("PurchaseOrderReceivedBy")
  /**
   * Cash "bags" the user received from drivers while acting as Branch Manager.
   */
  managerCustodyBagsHeld           ManagerCashCustody[]   @relation("ManagerCustodyManager")
  /**
   * Cash bags attributed to the user as the source driver (historical, even after handover).
   */
  managerCustodyBagsHandedOver     ManagerCashCustody[]   @relation("ManagerCustodyDriver")
  /**
   * Accountant verifications on manager custody bags.
   */
  managerCustodyVerifications      ManagerCashCustody[]   @relation("ManagerCustodyVerifiedBy")
  /**
   * Accountant rejections on manager custody bags.
   */
  managerCustodyRejections         ManagerCashCustody[]   @relation("ManagerCustodyRejectedBy")
  /**
   * Debt transfers where this user is the departing (source) driver.
   */
  debtTransfersAsSource            DebtTransfer[]         @relation("DebtTransferSource")
  /**
   * Debt transfers where this user is the replacement (target) driver.
   */
  debtTransfersAsTarget            DebtTransfer[]         @relation("DebtTransferTarget")
  /**
   * Debt transfers initiated by this user (GM or ACCOUNTANT).
   */
  debtTransfersExecuted            DebtTransfer[]         @relation("DebtTransferExecutor")
  /**
   * Debt transfers cancelled by this user.
   */
  debtTransfersCancelled           DebtTransfer[]         @relation("DebtTransferCanceller")
  /**
   * Orders whose cash responsibility was transferred FROM this driver (audit only).
   */
  ordersTransferredFrom            Order[]                @relation("OrderTransferredFromDriver")
  /**
   * HR — daily attendance rows for this user.
   */
  attendanceLogs                   AttendanceLog[]
  leaveRequests                    LeaveRequest[]         @relation("LeaveRequestUser")
  leaveApprovals                   LeaveRequest[]         @relation("LeaveRequestApprover")
  employeeLoans                    EmployeeLoan[]         @relation("EmployeeLoanUser")
  loanApprovals                    EmployeeLoan[]         @relation("EmployeeLoanApprover")
  /**
   * V19.9 — Call-Center Supervisor invoice edits/voids authored by
   * this user. Back-relation of `InvoiceAuditLog.actor`.
   */
  invoiceAuditEntries              InvoiceAuditLog[]      @relation("InvoiceAuditActor")
  /**
   * V19.10 — Fleet expense submissions authored by this user
   * (FLEET_SUPERVISOR) and review actions (APPROVED / REJECTED) taken
   * by this user (ACCOUNTANT / OWNER / GENERAL_MANAGER).
   */
  vehicleExpensesSubmitted         VehicleExpense[]       @relation("VehicleExpenseSubmittedBy")
  vehicleExpensesReviewed          VehicleExpense[]       @relation("VehicleExpenseReviewedBy")
  /**
   * V19.12 — refresh-token rotation (access token short-lived, refresh token
   * long-lived and single-use with revocation audit). Back-relation of
   * `RefreshToken.user`.
   */
  refreshTokens                    RefreshToken[]         @relation("RefreshTokenUser")
  /**
   * V19.16 — commission payouts earned by this user (SALE or COLLECTION).
   * Back-relation of `CommissionPayout.earner`.
   */
  commissionPayouts                CommissionPayout[]     @relation("CommissionEarner")
  /**
   * V19.16 — salary debt-hold slips tied to this employee's outstanding
   * customer debt. Back-relation of `DebtHold.employee`.
   */
  debtHolds                        DebtHold[]             @relation("DebtHoldEmployee")
  /**
   * V19.17 — debt-hold release vouchers this user stamped as disbursed.
   * Back-relation of `DebtHold.disbursedBy`.
   */
  debtHoldsDisbursed               DebtHold[]             @relation("DebtHoldDisbursedBy")
}

/**
 * V19.12 — opaque refresh tokens for the new rotation-based auth flow.
 * We store the SHA-256 of the token (never the token itself) so a DB
 * leak does not grant session takeover. Each row is single-use: on
 * redemption we stamp `usedAt` and issue a fresh row; a second redemption
 * attempt (token replay) revokes the entire token family.
 */
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  /**
   * SHA-256 hex of the raw token — never store the token itself.
   */
  tokenHash    String    @unique
  /**
   * Expiry hard-stop, enforced on redemption.
   */
  expiresAt    DateTime
  /**
   * Set when this token is redeemed by /refresh-token; second use is replay.
   */
  usedAt       DateTime?
  /**
   * Explicit revocation (logout, password change, replay detected).
   */
  revokedAt    DateTime?
  /**
   * Chain pointer — every rotation increments the generation id.
   */
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  /**
   * Optional client fingerprint — request-scoped, for audit only.
   */
  userAgent    String?
  ip           String?

  user User @relation("RefreshTokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ExpenseCategory {
  SOAP
  FUEL
  MISC
}

enum ExpenseStatus {
  PENDING_ACCOUNTANT
  APPROVED
  REJECTED
  AUDIT
}

/**
 * Field / branch expense funding source — drives wallet vs owner-radar accounting.
 */
enum ExpenseMethod {
  CASH
  PREPAID_CARD
}

/**
 * Unified append-only ledger (Sales, Expenses, Debts, settlements).
 */
enum GeneralLedgerEntryType {
  POS_SALE_COMPLETED
  EXPENSE_RECORDED
  WALLET_SETTLEMENT
  DEBT_ADJUSTMENT
}

enum PayrollStatus {
  PENDING
  PAID
}

/**
 * Recurring branch overheads (rent, utilities) — accrued by calendar month in reports.
 */
enum FixedExpenseCategory {
  RENT
  ELECTRICITY
  LEASE
  OTHER
}

/**
 * V8.5 — Singleton global config for acquirer fees (reporting only).
 * KNET uses flat + % with a selectable rule; card / payment links use %.
 */
enum KnetCommissionRule {
  HIGHER_OF_FLAT_AND_PERCENT
  FLAT_ONLY
  PERCENT_ONLY
}

model PaymentMethodFeeConfig {
  id                 String             @id
  knetFlatKd         Decimal            @default(0.1000) @db.Decimal(19, 4)
  knetPercentOfGross Decimal            @default(0.015000) @db.Decimal(19, 6)
  knetRule           KnetCommissionRule @default(HIGHER_OF_FLAT_AND_PERCENT)
  cardPercentOfGross Decimal            @default(0.025000) @db.Decimal(19, 6)
  updatedAt          DateTime           @updatedAt
}

/**
 * Branch operational expenses (manager-recorded); deducted from daily cash in reports.
 */
model BranchExpense {
  id            String          @id @default(uuid()) @db.Uuid
  title         String
  amount        Decimal         @db.Decimal(19, 4)
  category      ExpenseCategory
  expenseMethod ExpenseMethod   @default(CASH)
  status        ExpenseStatus   @default(PENDING_ACCOUNTANT)
  note          String?
  /**
   * Temporary local/file/data-url receipt pointer until cloud storage is configured.
   */
  receiptUrl    String?         @db.Text
  recordedById  String          @db.Uuid
  branchId      String?         @db.Uuid
  expenseDate   DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  recordedBy User    @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([status])
  @@index([recordedById])
  @@index([branchId])
}

/**
 * V19.10 — Fleet / vehicle expense (مصروفات السيارات).
 * Logged by the FLEET_SUPERVISOR with a MANDATORY receipt photo
 * (data URL — same transport as fuel receipts on BranchExpense). Flows
 * through the same PENDING → APPROVED / REJECTED gate as branch
 * expenses, but stays in its own table so vehicle-specific columns
 * (plate, odometer, vendor, repair type) can drive per-vehicle
 * reports without polluting the generic branch-expense stream.
 */
enum VehicleExpenseStatus {
  PENDING_ACCOUNTANT
  APPROVED
  REJECTED
}

enum VehicleExpenseType {
  FUEL
  OIL_CHANGE
  TIRES
  MECHANICAL_REPAIR
  ELECTRICAL_REPAIR
  BODY_REPAIR
  AC_REPAIR
  WASHING
  REGISTRATION
  INSURANCE
  SPARE_PARTS
  OTHER
}

model VehicleExpense {
  id              String               @id @default(uuid()) @db.Uuid
  vehiclePlate    String               @db.VarChar(32)
  vehicleLabel    String?              @db.VarChar(120)
  expenseType     VehicleExpenseType
  amount          Decimal              @db.Decimal(19, 4)
  odometerKm      Int?
  vendorName      String?              @db.VarChar(160)
  description     String?              @db.Text
  status          VehicleExpenseStatus @default(PENDING_ACCOUNTANT)
  /**
   * Required receipt: data URL (jpeg/png) captured at submission time.
   * Same transport pattern as BranchExpense.receiptUrl so the 1mb
   * express.json cap covers it. TEXT because data URLs outrun VARCHAR.
   */
  receiptUrl      String               @db.Text
  submittedById   String               @db.Uuid
  reviewedById    String?              @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?              @db.Text
  expenseDate     DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  submittedBy User  @relation("VehicleExpenseSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("VehicleExpenseReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([expenseDate])
  @@index([submittedById])
  @@index([vehiclePlate])
  @@index([expenseType])
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  phone          String
  phone2         String?
  motherContact  String?
  wifeContact    String?
  sonContact     String?
  /**
   * POS / call-center display name when captured.
   */
  displayName    String?
  /**
   * Optional when captured later from the driver’s paperwork.
   */
  address        String?
  /**
   * Kuwait-style address parts (POS). Composed line also stored in `address` when provided.
   */
  addressArea    String?
  addressBlock   String?
  addressStreet  String?
  addressAvenue  String?
  addressHouse   String?
  /**
   * Immutable attribution branch set from first transaction/subscription.
   */
  originBranchId String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  originBranch       Branch?                @relation("CustomerOriginBranch", fields: [originBranchId], references: [id], onDelete: SetNull)
  orders             Order[]
  wallet             CustomerWallet?
  transactionHistory TransactionHistory[]
  debtLedgerEntries  DebtLedgerEntry[]
  subscriptions      CustomerSubscription[]

  @@index([phone])
  @@index([phone2])
  @@index([displayName])
  @@index([originBranchId])
}

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  /**
   * Amount paid by the customer.
   */
  salePrice     Decimal  @default(0) @db.Decimal(19, 4)
  /**
   * Credit granted to the customer wallet.
   */
  actualBalance Decimal  @default(0) @db.Decimal(19, 4)
  /**
   * Calendar length of the subscription window from each activation date.
   */
  validityDays  Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriberWallets     CustomerWallet[]       @relation("WalletSubscriptionPlan")
  customerSubscriptions CustomerSubscription[] @relation("SubscriptionPlanInstances")
}

model CustomerWallet {
  id                         String    @id @default(uuid()) @db.Uuid
  customerId                 String    @unique @db.Uuid
  /**
   * Prepaid credit the company owes in service value.
   */
  balance                    Decimal   @default(0) @db.Decimal(19, 4)
  /**
   * Amount customer owes beyond wallet (e.g. order exceeded credit).
   */
  debt                       Decimal   @default(0) @db.Decimal(19, 4)
  /**
   * Last subscription activation instant (authoritative window start when set).
   */
  subscriptionActivatedAt    DateTime?
  /**
   * End of the prepaid subscription term (exclusive calendar boundary in UTC date math).
   */
  subscriptionExpiresAt      DateTime?
  subscriptionPlanId         String?   @db.Uuid
  subscriptionPlanName       String?
  /**
   * Dastur §5 (V1.5) — Call Center subscription-renewal reminders.
   * `subscriptionReminderCount` increments at most once every 24h when
   * the Call Center sends a WhatsApp/SMS nudge; `subscriptionLastReminderAt`
   * is the guard timestamp the backend uses to enforce that window.
   */
  subscriptionReminderCount  Int       @default(0)
  subscriptionLastReminderAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan? @relation("WalletSubscriptionPlan", fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  @@index([subscriptionExpiresAt])
}

/**
 * V19.4 — CC pack #2, #11, #12. An isolated ledger instance for a
 * single subscription purchase. Previously the system kept one row
 * per customer on `CustomerWallet` and each new activation *overwrote*
 * the plan fields; history lived only in `TransactionHistory`. That
 * worked for "what's my current balance" but broke the call-centre
 * use-cases the operators actually need:
 * • "أرني كل اشتراكاتي السابقة" (per-instance statement)
 * • "كم كان رصيدي لمّا انتهى الاشتراك الأسبق؟" (carried balance)
 * • "هذه الفاتورة تحت أي اشتراك قُطعت؟" (invoice→subscription link)
 * `CustomerWallet` stays as the live "sum" snapshot (fast reads for
 * POS). `CustomerSubscription` is the append-only audit trail and the
 * source of truth for history. Each activation now closes the prior
 * row (status = ROLLED_OVER) and inserts a new one whose
 * `carriedBalanceKd` carries the signed wallet delta forward, so the
 * operator can see *why* the new wallet started with a non-zero
 * balance or debt.
 * Plan fields are snapshotted (name, sale price, actual balance,
 * validity days) because `SubscriptionPlan` rows can be renamed or
 * deactivated; historical statements must render stable labels.
 */
model CustomerSubscription {
  id         String                     @id @default(uuid()) @db.Uuid
  customerId String                     @db.Uuid
  planId     String?                    @db.Uuid
  status     CustomerSubscriptionStatus @default(ACTIVE)

  // Snapshots taken at activation time so historical displays are stable
  // even if the plan is renamed, re-priced, or soft-deleted afterwards.
  planNameSnapshot          String
  planSalePriceSnapshot     Decimal @db.Decimal(19, 4)
  planActualBalanceSnapshot Decimal @db.Decimal(19, 4)
  planValidityDaysSnapshot  Int

  /**
   * Signed delta carried into this subscription from the predecessor:
   * + = prior prepaid balance migrated forward (good for customer)
   * - = prior outstanding debt migrated forward (owed at start)
   * 0 = first subscription ever, or predecessor was exactly even
   */
  carriedBalanceKd Decimal @default(0) @db.Decimal(19, 4)

  /**
   * Chain linkage. Strictly linear 1:1 — each subscription has at most
   * one predecessor, and at most one successor (found via the reverse
   * `successor` backref). We only persist the backward pointer because
   * the forward direction is derivable; keeping both would risk the
   * two columns drifting out of sync under concurrent updates.
   */
  parentSubscriptionId String? @unique @db.Uuid

  activatedAt  DateTime
  expiresAt    DateTime
  closedAt     DateTime?
  closedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan?     @relation("SubscriptionPlanInstances", fields: [planId], references: [id], onDelete: SetNull)
  parent    CustomerSubscription? @relation("SubscriptionChain", fields: [parentSubscriptionId], references: [id], onDelete: SetNull)
  successor CustomerSubscription? @relation("SubscriptionChain")

  orders             Order[]              @relation("OrderSubscription")
  transactionHistory TransactionHistory[] @relation("TransactionSubscription")

  @@index([customerId, createdAt])
  @@index([customerId, status])
  @@index([expiresAt])
}

model TransactionHistory {
  id             String                @id @default(uuid()) @db.Uuid
  type           LedgerTransactionType
  customerId     String                @db.Uuid
  orderId        String?               @db.Uuid
  /**
   * V19.4 — optional link to the CustomerSubscription instance this
   * transaction belongs to (activation, order-settlement under a given
   * plan, rollover carry, etc.). Nullable for backward compatibility
   * with rows written before the per-subscription ledger existed.
   */
  subscriptionId String?               @db.Uuid
  /**
   * Primary monetary amount for this line (order total, credit granted, etc.)
   */
  amount         Decimal               @db.Decimal(19, 4)
  balanceBefore  Decimal               @db.Decimal(19, 4)
  balanceAfter   Decimal               @db.Decimal(19, 4)
  debtBefore     Decimal               @db.Decimal(19, 4)
  debtAfter      Decimal               @db.Decimal(19, 4)
  metadata       Json?
  performedById  String?               @db.Uuid
  createdAt      DateTime              @default(now())

  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  performedBy  User?                 @relation("LedgerPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  subscription CustomerSubscription? @relation("TransactionSubscription", fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([subscriptionId])
}

model Order {
  id                      String            @id @default(uuid()) @db.Uuid
  status                  OrderStatus       @default(PENDING)
  serviceType             ServiceType       @default(NORMAL)
  totalPrice              Decimal           @db.Decimal(19, 4)
  cashStatus              CashStatus        @default(UNPAID)
  /**
   * Paper invoice reference when the driver has it; null if not yet recorded.
   */
  invoiceNumber           String?
  /**
   * Dastur §1 (V1.5) — Human-readable, globally unique order serial
   * composed as `<driverPrefix>-<globalCounter>`. Stamped at creation
   * time when the assigned driver has a `driverPrefix`; legacy rows
   * (and driver-less POS tickets) stay null for backward compatibility.
   */
  serialNumber            String?           @unique
  /**
   * Dastur §5 (V1.5) — Call Center collection reminders counter.
   * Increments at most once every 24h (see `lastReminderAt`).
   */
  reminderCount           Int               @default(0)
  lastReminderAt          DateTime?
  notes                   String?
  customerId              String            @db.Uuid
  driverId                String?           @db.Uuid
  /**
   * POS checkout: how sale was recognized for reporting (wallet vs external).
   */
  posPaymentMethod        PosPaymentMethod?
  /**
   * Set when the order reaches COMPLETED (for daily sales / GL-style reporting).
   */
  completedAt             DateTime?
  /**
   * Set when wallet + debt settlement ran for this order (idempotent).
   */
  walletSettledAt         DateTime?
  /**
   * Multi-invoice POS: single gateway payment for several orders (see PosPaymentBundle).
   */
  posPaymentBundleId      String?           @db.Uuid
  /**
   * Hosted Kuwait Gateway (or dev mock) URL issued at checkout for ONLINE orders.
   */
  posHostedPaymentUrl     String?           @db.Text
  /**
   * V1.7.0 — UPayments (or compatible provider) `trackId` returned by
   * the `/api/v1/charge` call. Persisted so we can re-query the gateway
   * for the authoritative payment status at callback time (Server-to-
   * Server inquiry), instead of trusting the webhook body blindly.
   * Also used by the customer-facing `/payment/success` page to poll
   * for settlement confirmation.
   */
  posGatewayTrackId       String?           @db.Text
  /**
   * V1.7.0 — Raw provider responses + webhook payloads for this order
   * (charge creation, callback bodies, inquiry results). Opaque JSON
   * kept for audit + support tickets. Never queried for business logic
   * — authoritative state lives on `Order` + `GeneralLedgerEntry`.
   */
  posGatewayMetadata      Json?
  /**
   * Manager cash handover shift that settled this CASH order into office custody.
   */
  handoverShiftId         String?           @db.Uuid
  /**
   * Dastur §5 — Debt Transfer audit column.
   * When a departing driver's outstanding cash is transferred to a
   * replacement driver, the order's `driverId` is reassigned to the
   * target driver. This column preserves the ORIGINAL driver so
   * historical sales / commission / shift reports can still attribute
   * the work to whoever actually issued the invoice.
   */
  transferredFromDriverId String?           @db.Uuid
  /**
   * V19.4 — CC pack #11. Points at the `CustomerSubscription` instance
   * that was active when this invoice was opened. Nullable so non-
   * subscription invoices (walk-ins, ad-hoc POS tickets) still work.
   * Populated at checkout time so the customer statement can group
   * invoices by subscription without having to reason about time
   * windows + plan overwrites.
   */
  subscriptionId          String?           @db.Uuid
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  customer              Customer              @relation(fields: [customerId], references: [id])
  driver                User?                 @relation("OrderDriver", fields: [driverId], references: [id])
  transferredFromDriver User?                 @relation("OrderTransferredFromDriver", fields: [transferredFromDriverId], references: [id], onDelete: SetNull)
  posPaymentBundle      PosPaymentBundle?     @relation(fields: [posPaymentBundleId], references: [id], onDelete: SetNull)
  handoverShift         Shift?                @relation("ShiftHandoverOrders", fields: [handoverShiftId], references: [id], onDelete: SetNull)
  subscription          CustomerSubscription? @relation("OrderSubscription", fields: [subscriptionId], references: [id], onDelete: SetNull)
  lineItems             OrderLineItem[]
  transactionHistory    TransactionHistory[]
  debtLedgerEntries     DebtLedgerEntry[]
  debtTransferLineItems DebtTransferOrder[]
  /**
   * V19.9 — audit trail of Call-Center Supervisor same-day edits and
   * soft-voids. Read via /api/orders/audit-log (Owner/GM/Accountant
   * only) and referenced in the invoice print page as a footer chip
   * when the order has been edited.
   */
  auditLogs             InvoiceAuditLog[]
  /**
   * V19.16 — commission payouts attributed to this order (SALE mode).
   * Back-relation of `CommissionPayout.sourceOrder`.
   */
  commissionPayouts     CommissionPayout[]    @relation("OrderCommissionPayouts")

  @@index([driverId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([driverId, cashStatus])
  @@index([completedAt])
  @@index([posPaymentMethod])
  @@index([posPaymentBundleId])
  @@index([handoverShiftId])
  @@index([transferredFromDriverId])
  @@index([serialNumber])
  @@index([subscriptionId])
  @@index([posGatewayTrackId])
}

/**
 * Dastur §1 (V1.5) — Global atomic counters (e.g. the single-row
 * "ORDER_SERIAL" used to stamp Order.serialNumber). One row per key.
 * Safely incremented inside Prisma transactions via `update({ data:
 * { value: { increment: 1 } } })` which is row-level-locking.
 */
model SerialCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/**
 * One hosted payment session for multiple POS orders (same customer, one gateway charge).
 */
model PosPaymentBundle {
  id            String   @id @default(uuid()) @db.Uuid
  driverId      String   @db.Uuid
  totalAmountKd Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  driver User    @relation("PosPaymentBundleDriver", fields: [driverId], references: [id])
  orders Order[]

  @@index([driverId])
}

model Shift {
  id                    String      @id @default(uuid()) @db.Uuid
  driverId              String      @db.Uuid
  status                ShiftStatus @default(OPEN)
  startedAt             DateTime    @default(now())
  endedAt               DateTime?
  /**
   * Cash amount the manager physically counted (optional audit).
   */
  declaredHandoverTotal Decimal?    @db.Decimal(19, 4)
  /**
   * Ledger total: orders settled PAID_TO_DRIVER → HANDED_OVER_TO_OFFICE in this handover.
   */
  systemHandoverTotal   Decimal?    @db.Decimal(19, 4)
  ordersSettledCount    Int?
  /**
   * Bank deposit receipt file path (e.g. /uploads/handover-receipts/...).
   */
  bankDepositReceiptUrl String?
  confirmedByManagerId  String?     @db.Uuid
  confirmedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  driver             User                 @relation("ShiftDriver", fields: [driverId], references: [id])
  confirmedByManager User?                @relation("ShiftConfirmedBy", fields: [confirmedByManagerId], references: [id])
  bankDepositLogs    BankDepositLog[]
  handoverOrders     Order[]              @relation("ShiftHandoverOrders")
  managerCustodyBags ManagerCashCustody[] @relation("ShiftManagerCustody")

  @@index([driverId, status])
}

model BankDepositLog {
  id                     String          @id @default(uuid()) @db.Uuid
  depositType            BankDepositType
  /**
   * Amount (KD) as declared on slip / Z-report for reconciliation.
   */
  amountKd               Decimal         @db.Decimal(19, 4)
  receiptImageUrl        String
  shiftId                String?         @db.Uuid
  uploadedById           String          @db.Uuid
  verifiedByAccountantId String?         @db.Uuid
  verifiedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  shift                Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  uploadedBy           User   @relation("BankDepositUploadedBy", fields: [uploadedById], references: [id])
  verifiedByAccountant User?  @relation("BankDepositVerifiedBy", fields: [verifiedByAccountantId], references: [id])

  @@index([createdAt])
  @@index([uploadedById])
  @@index([verifiedByAccountantId])
}

model Deposit {
  id           String        @id @default(uuid()) @db.Uuid
  driverId     String        @db.Uuid
  amount       Decimal       @db.Decimal(19, 4)
  type         DepositType
  receiptImage String        @db.Text
  status       DepositStatus @default(PENDING)
  auditComment String?
  auditedById  String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  driver    User  @relation("DepositDriver", fields: [driverId], references: [id], onDelete: Cascade)
  auditedBy User? @relation("DepositAuditedBy", fields: [auditedById], references: [id], onDelete: SetNull)

  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
  @@index([auditedById])
}

model OrderLineItem {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @db.Uuid
  label        String?
  starchOption StarchOption @default(NONE)
  quantity     Decimal      @db.Decimal(12, 4)
  unitPrice    Decimal      @db.Decimal(19, 4)
  /**
   * Optional link to an inventory SKU. When set, the order completion
   * pipeline (`PosService.posCheckout`, gateway finalizer, call-center
   * manual mark-paid) emits a matching `StockMovement(STOCK_OUT)` at
   * the driver's branch so cost-of-goods reconciles with sales. Kept
   * optional so legacy laundry line-items (garment-as-service) continue
   * to work with no inventory coupling.
   */
  stockItemId  String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItem StockItem? @relation(fields: [stockItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([stockItemId])
}

model DebtLedgerEntry {
  id          String             @id @default(uuid()) @db.Uuid
  customerId  String             @db.Uuid
  orderId     String?            @db.Uuid
  source      DebtSource
  category    DebtEntityCategory
  amount      Decimal            @db.Decimal(19, 4)
  branchId    String?            @db.Uuid
  actorUserId String?            @db.Uuid
  note        String?
  /// V19.11 — optional FK to the debt-creating entry this PAYMENT
  /// settles (FIFO allocation). `null` for the creation sources and
  /// for lump-sum payments that aren't tied to a specific invoice.
  refEntryId  String?            @db.Uuid
  /// V19.11 — idempotency / cross-reference key for backfill and
  /// dual-write. E.g. TransactionHistory.id of the settlement row
  /// that produced this PAYMENT entry. Enforced unique when present.
  sourceRef   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorUser         User?              @relation("DebtEntryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  refEntry          DebtLedgerEntry?   @relation("DebtLedgerEntryRef", fields: [refEntryId], references: [id], onDelete: SetNull)
  refChildren       DebtLedgerEntry[]  @relation("DebtLedgerEntryRef")
  /**
   * V19.16 — commission payouts generated from this PAYMENT entry
   * (COLLECTION mode). Back-relation of `CommissionPayout.sourceDebtEntry`.
   */
  commissionPayouts CommissionPayout[] @relation("DebtEntryCommissionPayouts")

  @@unique([sourceRef])
  @@index([customerId, createdAt])
  @@index([source, category, createdAt])
  @@index([orderId])
  @@index([branchId])
  @@index([refEntryId])
}

/**
 * Logical grouping for POS / manager item screens (not a second price source).
 */
model LaundryItemCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  nameEn    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LaundryPriceListItem[]
}

/**
 * Laundry price list (PDF tariff) — KD per garment × service tier.
 */
model LaundryPriceListItem {
  id               String                   @id @default(uuid()) @db.Uuid
  code             String                   @unique
  nameAr           String
  nameEn           String?
  sortOrder        Int                      @default(0)
  /**
   * When true, unit price must be entered manually (list prices are 0).
   */
  manualEntry      Boolean                  @default(false)
  /**
   * Soft-hide switch. Inactive items are excluded from POS / Driver catalogs
   * but remain available in manager admin views so historical pricing / names
   * never mutate under already-issued invoices.
   */
  isActive         Boolean                  @default(true)
  priceNormal      Decimal                  @db.Decimal(19, 4)
  priceUrgent      Decimal                  @db.Decimal(19, 4)
  pricePressOnly   Decimal?                 @db.Decimal(19, 4)
  priceUrgentPress Decimal?                 @db.Decimal(19, 4)
  categoryId       String?                  @db.Uuid
  category         LaundryItemCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchOverrides  LaundryBranchItemPrice[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

/**
 * Optional per-branch overrides. Null field = inherit master price from LaundryPriceListItem.
 */
model LaundryBranchItemPrice {
  id                     String   @id @default(uuid()) @db.Uuid
  branchId               String   @db.Uuid
  laundryPriceListItemId String   @db.Uuid
  priceNormal            Decimal? @db.Decimal(19, 4)
  priceUrgent            Decimal? @db.Decimal(19, 4)
  pricePressOnly         Decimal? @db.Decimal(19, 4)
  priceUrgentPress       Decimal? @db.Decimal(19, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  branch Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   LaundryPriceListItem @relation(fields: [laundryPriceListItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, laundryPriceListItemId])
  @@index([branchId])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions Permission[]
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  location  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  expenses              BranchExpense[]
  wallets               Wallet[]
  payrolls              Payroll[]
  fixedExpenseSchedules FixedExpenseSchedule[]
  debtLedgerEntries     DebtLedgerEntry[]
  originCustomers       Customer[]               @relation("CustomerOriginBranch")
  laundryBranchPrices   LaundryBranchItemPrice[]
  stockLevels           BranchStockLevel[]
  stockMovements        StockMovement[]
  managerCustodyBags    ManagerCashCustody[]     @relation("BranchManagerCustody")
  attendanceLogs        AttendanceLog[]
  purchaseOrders        PurchaseOrder[]
}

/**
 * Stage-D — daily attendance row per (user, logical Kuwait date).
 * `checkInAt` / `checkOutAt` are UTC timestamps; the unique `date`
 * column is the logical Kuwait-local day so one user can't have two
 * rows for the same day (idempotent upserts). `source` records where
 * the row came from: SHIFT_AUTO (daily cron), BIOMETRIC (stub for
 * fingerprint devices), or MANUAL (admin entry).
 */
model AttendanceLog {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  branchId    String?          @db.Uuid
  date        DateTime         @db.Date
  checkInAt   DateTime?
  checkOutAt  DateTime?
  source      AttendanceSource @default(SHIFT_AUTO)
  /**
   * Biometric device fingerprint / external record id (nullable).
   */
  externalRef String?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([userId, date])
  @@index([date])
  @@index([branchId, date])
  @@index([source])
}

enum AttendanceSource {
  SHIFT_AUTO
  BIOMETRIC
  MANUAL
}

/**
 * Stage-D — leave request workflow.
 * Employees submit a PENDING request; OWNER / GM / MANAGER / ACCOUNTANT
 * approve or reject. The approver's id + timestamp is stamped for
 * audit, and the A4 printable form carries a verification QR.
 */
model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  type           LeaveType
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  daysCount      Int
  reason         String?
  status         LeaveStatus @default(PENDING)
  approvedById   String?     @db.Uuid
  approvedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user       User  @relation(fields: [userId], references: [id], name: "LeaveRequestUser")
  approvedBy User? @relation(fields: [approvedById], references: [id], name: "LeaveRequestApprover")

  @@index([userId, startDate])
  @@index([status])
  @@index([startDate])
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * Stage-D — employee loans (سلف الموظفين).
 * Approved loans enter the ACTIVE state with `remaining` tracking the
 * outstanding balance. Each monthly payroll run is expected to
 * decrement `remaining` by `monthlyDeduction` — the automatic hook
 * lives on PayrollService.create (§D.5).
 */
model EmployeeLoan {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  amount           Decimal    @db.Decimal(19, 4)
  installmentCount Int
  monthlyDeduction Decimal    @db.Decimal(19, 4)
  remaining        Decimal    @db.Decimal(19, 4)
  reason           String?
  status           LoanStatus @default(PENDING)
  approvedById     String?    @db.Uuid
  approvedAt       DateTime?
  rejectedReason   String?
  /**
   * V19.20 — last "YYYY-MM" the payroll engine booked an instalment
   * against this loan. Used as an idempotency key inside
   * `PayrollService.create`: re-running the same month's payroll
   * observes this field and SKIPS the deduction so an instalment can
   * never be taken twice. NULL = never deducted via payroll yet.
   */
  lastDeductionYearMonth String? @db.VarChar(7)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user       User  @relation(fields: [userId], references: [id], name: "EmployeeLoanUser")
  approvedBy User? @relation(fields: [approvedById], references: [id], name: "EmployeeLoanApprover")

  @@index([userId])
  @@index([status])
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  SETTLED
  REJECTED
}

model Payroll {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  branchId          String        @db.Uuid
  basicSalary       Decimal       @db.Decimal(19, 4)
  allowances        Decimal       @default(0) @db.Decimal(19, 4)
  deductions        Decimal       @default(0) @db.Decimal(19, 4)
  /**
   * V19.16 — sum of `CommissionPayout.amount` released during this pay
   * run. Displayed as a dedicated payslip line; NEVER folded into
   * `allowances` (DUSTUR §E.x: commission is tracked in its own ledger).
   * Purely informational on the Payroll row — authoritative state lives
   * on `CommissionPayout.payrollId`.
   */
  commissionAmount  Decimal       @default(0) @db.Decimal(19, 4)
  /**
   * V19.16 — amount withheld this run due to open customer debt
   * attributed to the employee. Subtracted from net pay but shown as a
   * separate line, not aggregated into `deductions`. Mirrored on
   * `DebtHold.holdAmount` for the matching HELD rows of this payroll.
   */
  debtHoldAmount    Decimal       @default(0) @db.Decimal(19, 4)
  /**
   * V19.16 — amount released back to the employee this run because the
   * previously-held customer debt has been collected. Added to net pay
   * as a separate positive line.
   */
  debtReleaseAmount Decimal       @default(0) @db.Decimal(19, 4)
  /**
   * V19.20 — sum of employee-loan instalments booked against this
   * payroll run. Shown as a dedicated payslip line and subtracted from
   * net pay. Idempotency is enforced upstream via
   * `EmployeeLoan.lastDeductionYearMonth` so re-running the same
   * month's payroll produces `loanDeduction = 0` on the replay (the
   * scheduled instalment was already consumed on the first run).
   */
  loanDeduction     Decimal       @default(0) @db.Decimal(19, 4)
  paymentDate       DateTime
  status            PayrollStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  /**
   * V19.16 — back-relations for the split payslip bands.
   */
  commissionPayouts CommissionPayout[]
  debtHolds         DebtHold[]

  @@index([branchId, paymentDate])
  @@index([userId, paymentDate])
  @@index([status])
}

model FixedExpenseSchedule {
  id            String               @id @default(uuid()) @db.Uuid
  branchId      String               @db.Uuid
  title         String
  category      FixedExpenseCategory
  monthlyAmount Decimal              @db.Decimal(19, 4)
  effectiveFrom DateTime             @default(now())
  effectiveTo   DateTime?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([isActive])
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(19, 4)
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  resource  String
  changes   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])
}

model GeneralLedgerEntry {
  id          String                 @id @default(uuid()) @db.Uuid
  entryType   GeneralLedgerEntryType
  amount      Decimal                @db.Decimal(19, 4)
  memo        String?
  metadata    Json?
  customerId  String?                @db.Uuid
  orderId     String?                @db.Uuid
  expenseId   String?                @db.Uuid
  actorUserId String?                @db.Uuid
  createdAt   DateTime               @default(now())

  @@index([entryType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([orderId])
  @@index([expenseId])
}

// ─── Inventory & Stock (Dastur §4 Smart Inventory) ───────────────────────────
// Owner & Accountant consume the Smart Inventory report; Accountant records
// stock-in movements (Qty / Cost / Supplier). Stock colours (Yellow = low, Red
// = out) are derived on the server from `BranchStockLevel.quantityOnHand` vs
// `reorderPoint` (branch) falling back to `StockItem.reorderPointDefault`.

/**
 * Operational supply category (cleaning, packaging, spare parts, uniforms, …).
 */
model InventoryCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  nameEn    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockItem[]
}

/**
 * External supplier (detergent vendors, parts wholesalers, etc.).
 */
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
}

/**
 * Master inventory catalog — non-laundry operational supplies.
 */
model StockItem {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique
  nameAr              String
  nameEn              String?
  /**
   * Unit of measure (pcs, kg, L, box, …).
   */
  unit                String   @default("pcs")
  categoryId          String?  @db.Uuid
  /**
   * Default reorder threshold for branches without an override.
   */
  reorderPointDefault Decimal  @default(0) @db.Decimal(19, 4)
  /**
   * Most recent purchase unit cost (KD) — set from the latest STOCK_IN.
   */
  lastUnitCost        Decimal? @db.Decimal(19, 4)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category                  InventoryCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchLevels              BranchStockLevel[]
  movements                 StockMovement[]
  orderLineItems            OrderLineItem[]
  purchaseOrderLines        PurchaseOrderLine[]
  purchaseOrderReceiptLines PurchaseOrderReceiptLine[]

  @@index([categoryId])
}

/**
 * Per-branch quantity on hand and optional branch-level reorder override.
 */
model BranchStockLevel {
  id             String    @id @default(uuid()) @db.Uuid
  branchId       String    @db.Uuid
  stockItemId    String    @db.Uuid
  quantityOnHand Decimal   @default(0) @db.Decimal(19, 4)
  /**
   * Branch override for reorder threshold (null → fall back to item default).
   */
  reorderPoint   Decimal?  @db.Decimal(19, 4)
  /**
   * Weighted moving-average unit cost, recomputed on every STOCK_IN.
   */
  avgUnitCost    Decimal?  @db.Decimal(19, 4)
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, stockItemId])
  @@index([branchId])
  @@index([stockItemId])
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

/**
 * Immutable audit row for every quantity change on a `BranchStockLevel`.
 * Qty is signed (STOCK_IN positive, STOCK_OUT / TRANSFER_OUT negative).
 * `unitCost`/`totalCost` only set for STOCK_IN (purchase) — they drive the
 * running moving-average cost on `BranchStockLevel.avgUnitCost`.
 */
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  stockItemId  String            @db.Uuid
  branchId     String            @db.Uuid
  type         StockMovementType
  quantity     Decimal           @db.Decimal(19, 4)
  unitCost     Decimal?          @db.Decimal(19, 4)
  totalCost    Decimal?          @db.Decimal(19, 4)
  supplierId   String?           @db.Uuid
  recordedById String            @db.Uuid
  /**
   * External reference — PO number, supplier invoice, transfer ticket.
   */
  reference    String?
  note         String?
  /**
   * Optional uploaded delivery-note / receipt (≤ 1 MB per Dastur §1).
   */
  receiptUrl   String?           @db.Text
  createdAt    DateTime          @default(now())

  stockItem  StockItem @relation(fields: [stockItemId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recordedBy User      @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])

  @@index([stockItemId])
  @@index([branchId])
  @@index([supplierId])
  @@index([createdAt])
}

// ╭──────────────────────────────────────────────────────────────╮
// │ Stage-F Cosmetic — Purchase Order workflow                   │
// │ supplier → PO (DRAFT → SENT → PARTIALLY_RECEIVED → RECEIVED) │
// │ Each receipt generates StockMovement rows via InventoryService │
// ╰──────────────────────────────────────────────────────────────╯

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/**
 * A purchase order raised against a Supplier for a specific Branch.
 * Totals are denormalised on creation; on every receipt the service
 * recomputes `quantityReceived` on lines and transitions the overall
 * `status` (SENT → PARTIALLY_RECEIVED → RECEIVED).
 */
model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  /**
   * Human-readable serial: PO-YYYYMMDD-NNNN.
   */
  poNumber        String              @unique
  supplierId      String              @db.Uuid
  /**
   * Branch that will receive the goods.
   */
  branchId        String              @db.Uuid
  status          PurchaseOrderStatus @default(DRAFT)
  /**
   * Total KD value (sum of line totals). Computed at create/update time.
   */
  totalKd         Decimal             @default(0) @db.Decimal(19, 4)
  notes           String?
  expectedAt      DateTime?
  createdById     String              @db.Uuid
  approvedById    String?             @db.Uuid
  approvedAt      DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplier   Supplier               @relation(fields: [supplierId], references: [id])
  branch     Branch                 @relation(fields: [branchId], references: [id])
  createdBy  User                   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  approvedBy User?                  @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      PurchaseOrderLine[]
  receipts   PurchaseOrderReceipt[]

  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @db.Uuid
  stockItemId      String   @db.Uuid
  quantityOrdered  Decimal  @db.Decimal(19, 4)
  quantityReceived Decimal  @default(0) @db.Decimal(19, 4)
  unitCost         Decimal  @db.Decimal(19, 4)
  lineTotal        Decimal  @db.Decimal(19, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockItem     StockItem                  @relation(fields: [stockItemId], references: [id])
  receiptLines  PurchaseOrderReceiptLine[]

  @@index([purchaseOrderId])
  @@index([stockItemId])
}

/**
 * One physical delivery against a PurchaseOrder. A PO can have many
 * receipts (partial deliveries). Each receipt creates a StockMovement
 * per received line via `InventoryService.stockIn(...)`.
 */
model PurchaseOrderReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @db.Uuid
  receivedById    String   @db.Uuid
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedBy    User                       @relation("PurchaseOrderReceivedBy", fields: [receivedById], references: [id])
  lines         PurchaseOrderReceiptLine[]

  @@index([purchaseOrderId])
}

model PurchaseOrderReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  receiptId           String  @db.Uuid
  purchaseOrderLineId String  @db.Uuid
  stockItemId         String  @db.Uuid
  quantityReceived    Decimal @db.Decimal(19, 4)
  unitCost            Decimal @db.Decimal(19, 4)
  /**
   * StockMovement row this receipt line created.
   */
  stockMovementId     String? @db.Uuid

  receipt           PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine    @relation(fields: [purchaseOrderLineId], references: [id])
  stockItem         StockItem            @relation(fields: [stockItemId], references: [id])

  @@index([receiptId])
  @@index([purchaseOrderLineId])
  @@index([stockItemId])
}

/**
 * Dastur §3 — Manager Accountability.
 * One row per "bag" of cash physically received by a Branch Manager from a Driver.
 * - receivedFromDriverAt starts the 24h aging clock.
 * - status drives the aging / verification lifecycle.
 * - depositSlipUrl is the bank deposit slip photo (required to leave PENDING_DEPOSIT).
 * - The Accountant must verify the slip to close custody (→ VERIFIED).
 */
model ManagerCashCustody {
  id                     String                   @id @default(uuid()) @db.Uuid
  managerId              String                   @db.Uuid
  driverId               String                   @db.Uuid
  branchId               String?                  @db.Uuid
  /**
   * Closed handover shift that produced this bag.
   */
  shiftId                String?                  @db.Uuid
  /**
   * Cash amount handed over from driver to manager (KWD).
   */
  amountKd               Decimal                  @db.Decimal(19, 4)
  settledOrderCount      Int                      @default(0)
  status                 ManagerCashCustodyStatus @default(PENDING_DEPOSIT)
  /**
   * Aging clock starts here.
   */
  receivedFromDriverAt   DateTime                 @default(now())
  slipUploadedAt         DateTime?
  depositSlipUrl         String?                  @db.Text
  verifiedByAccountantId String?                  @db.Uuid
  verifiedAt             DateTime?
  rejectedByAccountantId String?                  @db.Uuid
  rejectedAt             DateTime?
  rejectionReason        String?
  note                   String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  manager              User    @relation("ManagerCustodyManager", fields: [managerId], references: [id], onDelete: Restrict)
  driver               User    @relation("ManagerCustodyDriver", fields: [driverId], references: [id], onDelete: Restrict)
  branch               Branch? @relation("BranchManagerCustody", fields: [branchId], references: [id], onDelete: SetNull)
  shift                Shift?  @relation("ShiftManagerCustody", fields: [shiftId], references: [id], onDelete: SetNull)
  verifiedByAccountant User?   @relation("ManagerCustodyVerifiedBy", fields: [verifiedByAccountantId], references: [id], onDelete: SetNull)
  rejectedByAccountant User?   @relation("ManagerCustodyRejectedBy", fields: [rejectedByAccountantId], references: [id], onDelete: SetNull)

  @@index([managerId, status])
  @@index([status, receivedFromDriverAt])
  @@index([branchId])
  @@index([shiftId])
  @@index([driverId])
}

/**
 * Dastur §5 — Debt Transfer document.
 * When a driver departs with outstanding cash custody (orders whose
 * cashStatus is still PAID_TO_DRIVER), GM or ACCOUNTANT can transfer
 * that responsibility to a replacement driver. The transfer is a
 * formal document that requires:
 * 1. GM / ACCOUNTANT initiates with source, target, and order list.
 * 2. Status moves to AWAITING_SIGNATURES.
 * 3. Source driver signs (digital acknowledgement of release).
 * 4. Target driver signs (digital acceptance of debt).
 * 5. Finalize: orders are reassigned (driverId = target, with
 * transferredFromDriverId preserved), and a pair of
 * DEBT_ADJUSTMENT GL entries records the ledger effect.
 * OWNER has READ-ONLY access (reports + filtering only — cannot
 * initiate, sign, finalize, or cancel).
 */
model DebtTransfer {
  id              String             @id @default(uuid()) @db.Uuid
  sourceDriverId  String             @db.Uuid
  targetDriverId  String             @db.Uuid
  totalAmount     Decimal            @db.Decimal(19, 4)
  orderCount      Int                @default(0)
  reason          String?            @db.Text
  notes           String?            @db.Text
  status          DebtTransferStatus @default(DRAFT)
  executedById    String             @db.Uuid
  executedByRole  SafariRole
  sourceSignedAt  DateTime?
  targetSignedAt  DateTime?
  finalizedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?            @db.Text
  cancelledById   String?            @db.Uuid
  /**
   * Opaque server-generated signature token printed on the receipt for tamper detection.
   */
  systemSignature String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  sourceDriver User                @relation("DebtTransferSource", fields: [sourceDriverId], references: [id], onDelete: Restrict)
  targetDriver User                @relation("DebtTransferTarget", fields: [targetDriverId], references: [id], onDelete: Restrict)
  executedBy   User                @relation("DebtTransferExecutor", fields: [executedById], references: [id], onDelete: Restrict)
  cancelledBy  User?               @relation("DebtTransferCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  orders       DebtTransferOrder[]

  @@index([sourceDriverId, createdAt])
  @@index([targetDriverId, createdAt])
  @@index([status, createdAt])
  @@index([executedById, createdAt])
  @@index([createdAt])
}

/**
 * Line item: a single order included in a debt-transfer document.
 */
model DebtTransferOrder {
  id             String   @id @default(uuid()) @db.Uuid
  debtTransferId String   @db.Uuid
  orderId        String   @db.Uuid
  /**
   * Snapshot of the order's receivable at inclusion time (KWD).
   */
  amountSnapshot Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now())

  debtTransfer DebtTransfer @relation(fields: [debtTransferId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([debtTransferId])
  @@index([orderId])
}

/**
 * V19.9 — Call-Center Supervisor invoice audit trail.
 * Every same-day EDIT and every VOID performed by a CALL_CENTER_SUPERVISOR
 * writes exactly one row. Rows are immutable — the report surface
 * (Owner / GM / Accountant at /reports/invoice-audit) is read-only
 * and never PATCHes or DELETEs.
 * `beforeSnapshot` / `afterSnapshot` hold a normalized JSON mirror of
 * the order at those two instants (see `buildInvoiceAuditSnapshot` in
 * the orders service). `changedFields` is the flat list of top-level
 * keys that actually changed between the two snapshots, cached here so
 * the UI does not have to diff JSON client-side.
 * `financialImpactFils` is the signed delta applied to GL revenue by
 * this action, in fils, positive = revenue added, negative = revenue
 * removed. Sum(financialImpactFils) over any day MUST equal the delta
 * between the old and new GL running totals — the reconciliation cron
 * enforces this as a post-write invariant.
 * `kuwaitDay` (char(10)) is the Kuwait-local YYYY-MM-DD key computed at
 * write time so range queries can use a simple equality index without
 * a timezone-aware WHERE.
 */
model InvoiceAuditLog {
  id                  String             @id @default(uuid()) @db.Uuid
  orderId             String             @db.Uuid
  action              InvoiceAuditAction
  actorId             String             @db.Uuid
  actorRole           SafariRole
  actorName           String
  beforeSnapshot      Json
  afterSnapshot       Json
  changedFields       String[]           @default([])
  reason              String?            @db.Text
  financialImpactFils BigInt             @default(0)
  kuwaitDay           String             @db.Char(10)
  createdAt           DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User  @relation("InvoiceAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([actorId])
  @@index([kuwaitDay])
  @@index([action, createdAt])
}

// ────────────────────────────────────────────────────────────────────
// V19.16 — Commission, Debt-Hold & System Toggles
// ────────────────────────────────────────────────────────────────────

/**
 * V19.16 — whether a commission rule fires on sale creation (SALE) or
 * only after the invoice is collected (COLLECTION). A single rule is
 * never both; Owner creates two rules if both behaviours are desired.
 */
enum CommissionMode {
  SALE
  COLLECTION
}

/**
 * V19.16 — "أساس الحساب" dropdown. Picks which monetary base the
 * `percentage` is applied to at earning time.
 * - ORDER_TOTAL          : raw `Order.totalPrice`.
 * - INVOICE_TOTAL        : same as ORDER_TOTAL today; reserved for a
 * future invoice-vs-order split (V19.17+).
 * - NET_AFTER_KNET       : `Order.totalPrice` minus the KNET/card fee
 * allocated to this order (see
 * `PaymentMethodFeeConfig`). Applies only
 * when `posPaymentMethod` is a card method.
 * - EXCLUDE_SUBSCRIPTIONS: zero out commission for orders backed by a
 * `CustomerSubscription` (so recurring plan
 * draw-downs don't earn a fresh commission).
 */
enum CommissionCalculationBase {
  ORDER_TOTAL
  INVOICE_TOTAL
  NET_AFTER_KNET
  EXCLUDE_SUBSCRIPTIONS
}

/**
 * V19.16 — when a PENDING payout transitions to RELEASED (eligible for
 * the next cut-run).
 * - IMMEDIATE        : as soon as the triggering event lands.
 * - AFTER_COLLECTION : only after the matching invoice is fully
 * collected (open debt = 0 for the order).
 * - END_OF_MONTH     : at the Kuwait-local month boundary.
 */
enum CommissionPayoutTiming {
  IMMEDIATE
  AFTER_COLLECTION
  END_OF_MONTH
}

/**
 * V19.16 — lifecycle of a single CommissionPayout row.
 * PENDING   → created by the earning hook, not yet eligible for pay.
 * RELEASED  → release condition (timing) is met; waiting for payroll.
 * PAID      → stamped on `payrollId` and surfaced on the commission
 * report; informational only on the Payroll row.
 * CANCELLED → reversed (e.g. order voided, debt payment refunded).
 */
enum CommissionPayoutStatus {
  PENDING
  RELEASED
  PAID
  CANCELLED
}

/**
 * V19.16 — Owner-configurable commission rules. A rule is scoped to an
 * optional `SafariRole` (null = applies to all qualifying users). The
 * backend picks the most-specific active rule per (mode, role) at
 * earning time; when two rules tie on specificity the most recently
 * updated one wins. Stored in its own ledger so commission is NEVER
 * silently folded into `Payroll.allowances`.
 */
model CommissionRule {
  id               String                    @id @default(uuid()) @db.Uuid
  name             String
  isActive         Boolean                   @default(true)
  role             SafariRole?
  mode             CommissionMode
  calculationBase  CommissionCalculationBase @default(ORDER_TOTAL)
  /**
   * Percentage expressed as a plain number, not a fraction — e.g.
   * `5.0000` means 5%. We store 4 decimal digits so Owner can express
   * fine-grained rates like 2.5% or 0.75%.
   */
  percentage       Decimal                   @db.Decimal(7, 4)
  /**
   * Orders whose `calculationBase` total is below this threshold are
   * skipped entirely — no PENDING payout is created.
   */
  minInvoiceAmount Decimal                   @default(0) @db.Decimal(19, 4)
  payoutTiming     CommissionPayoutTiming    @default(IMMEDIATE)
  /**
   * When true, a RELEASED payout is auto-CANCELLED if the earner has
   * open customer debt at payroll-cut time (i.e. the commission is
   * forfeited while the driver is in debt). Independent of DebtHold.
   */
  linkedToDebt     Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  payouts CommissionPayout[]

  @@index([isActive, role])
  @@index([mode])
}

/**
 * V19.16 — one payout row per (rule × source × earner). The source is
 * either an `Order` (SALE mode) or a `DebtLedgerEntry` PAYMENT
 * (COLLECTION mode); exactly one of the two FKs is set. Payouts stay
 * PENDING until the rule's `payoutTiming` is satisfied, flip to
 * RELEASED, then PAID when attached to a `Payroll` row via `payrollId`.
 * Unique indexes prevent double-earning: the same order / debt entry
 * can produce at most one payout per (earner, rule, mode).
 */
model CommissionPayout {
  id                String                 @id @default(uuid()) @db.Uuid
  ruleId            String                 @db.Uuid
  earnerUserId      String                 @db.Uuid
  mode              CommissionMode
  /**
   * The monetary base the rule's percentage was applied to (resolved
   * from `calculationBase` at earning time). Stored verbatim so the
   * commission report can always recompute `amount = basisAmount * pct`
   * without re-querying the source order.
   */
  basisAmount       Decimal                @db.Decimal(19, 4)
  percentage        Decimal                @db.Decimal(7, 4)
  amount            Decimal                @db.Decimal(19, 4)
  status            CommissionPayoutStatus @default(PENDING)
  sourceOrderId     String?                @db.Uuid
  sourceDebtEntryId String?                @db.Uuid
  payrollId         String?                @db.Uuid
  earnedAt          DateTime               @default(now())
  releasedAt        DateTime?
  paidAt            DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  rule            CommissionRule   @relation(fields: [ruleId], references: [id])
  earner          User             @relation("CommissionEarner", fields: [earnerUserId], references: [id])
  sourceOrder     Order?           @relation("OrderCommissionPayouts", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  sourceDebtEntry DebtLedgerEntry? @relation("DebtEntryCommissionPayouts", fields: [sourceDebtEntryId], references: [id], onDelete: SetNull)
  payroll         Payroll?         @relation(fields: [payrollId], references: [id], onDelete: SetNull)

  @@unique([sourceOrderId, ruleId, earnerUserId], name: "uniq_commission_payout_per_order")
  @@unique([sourceDebtEntryId, ruleId, earnerUserId], name: "uniq_commission_payout_per_debt_entry")
  @@index([earnerUserId, earnedAt])
  @@index([status])
  @@index([ruleId])
  @@index([payrollId])
}

/**
 * V19.16 — salary debt-hold lifecycle.
 * HELD     : debt-hold policy was ON at the payroll cut; the
 * `holdAmount` is parked on the Payroll row but not yet
 * paid out.
 * RELEASED : the underlying customer debt has been collected (FIFO
 * waterfall); the slip is eligible for a release entry in
 * the next payroll run.
 */
enum DebtHoldStatus {
  HELD
  RELEASED
}

/**
 * V19.16 — policy dial for computing `holdAmount` when the Owner
 * enables debt-holds.
 * FULL  : hold the entire open customer-debt total per employee.
 * FIXED : cap the hold at `DebtHoldPolicy.fixedAmount` regardless of
 * the actual debt. Useful when Owner wants a predictable slice
 * off payroll instead of a variable one.
 */
enum DebtHoldMode {
  FULL
  FIXED
}

/**
 * V19.16 — per-employee, per-payroll-run snapshot of the debt-hold
 * applied against their net pay. `debtAmount` is the live customer-debt
 * total at cut time; `holdAmount` is the slice actually withheld (may
 * equal the full debt or be capped by policy). When the matching
 * customer debt is collected, the row flips to RELEASED and the next
 * payroll run adds an equal positive line via `Payroll.debtReleaseAmount`.
 * Never merged into `Payroll.deductions` — it's always shown as a
 * dedicated payslip band so the employee can see what's being held.
 */
model DebtHold {
  id             String         @id @default(uuid()) @db.Uuid
  employeeUserId String         @db.Uuid
  /**
   * The payroll run that withheld this slip. Nullable during the brief
   * window between computing the hold and persisting the Payroll row.
   */
  payrollId      String?        @db.Uuid
  debtAmount     Decimal        @db.Decimal(19, 4)
  holdAmount     Decimal        @db.Decimal(19, 4)
  /**
   * Amount already surfaced on a subsequent Payroll's
   * `debtReleaseAmount` line. Tracked so a partial collection doesn't
   * double-release.
   */
  releasedAmount Decimal        @default(0) @db.Decimal(19, 4)
  status         DebtHoldStatus @default(HELD)
  releaseDate    DateTime?
  /**
   * V19.17 — The release is now a voucher-style disbursement decoupled
   * from the payroll cycle. Once a hold is RELEASED the admin still
   * has to pay the employee (cash, bank transfer, …) and stamp the
   * row via `markDisbursed`. `disbursedAt` tracks when that happened;
   * `disbursedById` captures the actor for the audit trail.
   */
  disbursedAt    DateTime?
  disbursedById  String?        @db.Uuid
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee    User     @relation("DebtHoldEmployee", fields: [employeeUserId], references: [id])
  payroll     Payroll? @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  disbursedBy User?    @relation("DebtHoldDisbursedBy", fields: [disbursedById], references: [id], onDelete: SetNull)

  @@index([employeeUserId, status])
  @@index([payrollId])
  @@index([status, disbursedAt])
}

/**
 * V19.16 — singleton Owner-facing knob that governs how `DebtHold`
 * rows are computed at payroll cut. The `id` is the literal string
 * `"singleton"` so we get upsert-by-id semantics without a separate
 * "which row is active" column. When `isActive=false` no holds are
 * created; existing HELD rows are still tracked for release.
 */
model DebtHoldPolicy {
  id          String       @id @default("singleton")
  isActive    Boolean      @default(false)
  holdMode    DebtHoldMode @default(FULL)
  fixedAmount Decimal?     @db.Decimal(19, 4)
  updatedAt   DateTime     @updatedAt
}

/**
 * V19.17 — singleton payroll-level settings surfaced on the Owner
 * Settings Dashboard. These knobs are independent from the `PAYROLL`
 * master toggle (which only switches the payroll feature on/off) — they
 * tune *how* payroll behaves when enabled.
 *
 * • `payDayOfMonth` — default day the Owner cuts monthly payroll (1–28
 *   to avoid month-end drift). Purely informational today; the actual
 *   run is still triggered by OWNER/GM from `/payroll`, but the value
 *   is used to pre-fill the payment date and drives future automation
 *   work (cron-triggered auto-cuts).
 * • `autoDeductLoans` — when true, any OUTSTANDING employee loan
 *   instalments due up to the payroll payment date are auto-applied as
 *   `deductions` on the generated Payroll row (mirrors existing
 *   behaviour; the toggle just exposes it to the Owner).
 * • `linkWithAttendance` — when true, late-entries + unapproved
 *   absences logged on the Attendance module deduct proportional
 *   amounts from the salary. Off by default so existing payroll runs
 *   do not suddenly surface retroactive cuts.
 */
model PayrollSettings {
  id                 String   @id @default("singleton")
  payDayOfMonth      Int      @default(1)
  autoDeductLoans    Boolean  @default(true)
  linkWithAttendance Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

/**
 * V19.16 — master ON/OFF registry for top-level subsystems. Controllers
 * consult `SystemToggle` before running the logic they gate (commission
 * hooks, debt-hold policy, payroll cuts, loan disbursement, attendance
 * capture). Missing row = treated as enabled (fail-open) for backwards
 * compatibility with the pre-V19.16 behaviour.
 */
enum SystemToggleKey {
  COMMISSION
  DEBT_HOLD
  PAYROLL
  LOANS
  ATTENDANCE
}

model SystemToggle {
  key       SystemToggleKey @id
  isEnabled Boolean         @default(true)
  /**
   * Optional actor audit: the user id that last flipped the toggle.
   * Kept loose (no FK) so toggles can be seeded without a real user.
   */
  updatedBy String?         @db.Uuid
  updatedAt DateTime        @updatedAt
}
