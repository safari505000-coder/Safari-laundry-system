// Safari Fast Group — PostgreSQL schema (UUID PKs). Migrations not applied yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/** Institutional roles — enforced in app, permissions, and JWT guards. */
enum SafariRole {
  OWNER
  GENERAL_MANAGER
  MANAGER
  DRIVER
  WORKER
  CALL_CENTER
  ACCOUNTANT
  SUPERVISOR
  VIEWER
}

enum OrderStatus {
  PENDING
  PICKED_UP
  IN_PROGRESS
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELED
}

enum ServiceType {
  EXPRESS
  NORMAL
}

/** Cash custody for completed COD-style orders. */
enum CashStatus {
  UNPAID
  PAID_TO_DRIVER
  HANDED_OVER_TO_OFFICE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum LedgerTransactionType {
  SUBSCRIPTION_ACTIVATION
  ORDER_WALLET_SETTLEMENT
}

/** POS / daily sales — how the non-wallet portion was collected (if any). */
enum PosPaymentMethod {
  SUBSCRIPTION_WALLET
  CASH
  KNET
  PAYMENT_LINK
  DEBT_ON_ACCOUNT
  ONLINE
}

enum StarchOption {
  NONE
  STARCH_25
}

enum DebtSource {
  SUBSCRIPTION_OVERUSE
  INVOICE_SHORTFALL
}

enum DebtEntityCategory {
  BRANCH
  DRIVER
  OWNER
  CALL_CENTER
}

/** Manager shift-end bank paperwork for accountant reconciliation. */
enum BankDepositType {
  CASH_DEPOSIT_SLIP
  KNET_Z_REPORT
}

enum DepositType {
  CASH
  KNET
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Dastur §2.MANAGER / §3 — Manager custody aging.
 * Lifecycle of a cash "bag" a Branch Manager receives from a Driver:
 *   PENDING_DEPOSIT      → received from driver, no bank slip yet (24h clock runs)
 *   AWAITING_VERIFICATION → manager uploaded slip, accountant to verify
 *   VERIFIED             → accountant approved, custody closed
 *   REJECTED             → accountant rejected slip, back under manager liability
 */
/**
 * Dastur §5 — Debt transfer workflow states.
 * DRAFT               → created by GM/ACCOUNTANT, still editable
 * AWAITING_SIGNATURES → submitted, waiting on both driver signatures
 * COMPLETED           → both signed + finalized (orders reassigned + GL posted)
 * CANCELLED           → voided before finalization
 */
enum DebtTransferStatus {
  DRAFT
  AWAITING_SIGNATURES
  COMPLETED
  CANCELLED
}

enum ManagerCashCustodyStatus {
  PENDING_DEPOSIT
  AWAITING_VERIFICATION
  VERIFIED
  REJECTED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  /** Unique login handle (staff ID / username). */
  username    String     @unique
  password    String
  fullName    String
  /** Legacy corporate employee number (optional). */
  employeeId  String?    @unique
  /** Legacy job title (optional). */
  jobTitle    String?
  phone       String?    @unique
  /** Optional vehicle display label for tracking UI (e.g. Toyota LC300). */
  vehicleLabel String?
  /** Last GPS point as "lat,lng". */
  lastKnownLocation String?
  /**
   * Dastur §1 (V1.5) — Owner-assigned single-letter prefix for drivers
   * ("A", "B", ...). Combined with the global SerialCounter to stamp
   * every outgoing order with a human-readable serial like "A-1042".
   * Optional: non-driver users never receive one.
   */
  driverPrefix String?   @unique
  safariRole  SafariRole @default(DRIVER)
  /** Owner toggle: inactive users cannot sign in. */
  isActive    Boolean    @default(true)
  roleId      String     @db.Uuid
  branchId    String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  role           Role     @relation(fields: [roleId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])
  auditLogs          AuditLog[]
  ordersAsDriver     Order[]  @relation("OrderDriver")
  shiftsAsDriver        Shift[]             @relation("ShiftDriver")
  shiftConfirmations    Shift[]             @relation("ShiftConfirmedBy")
  ledgerTransactions    TransactionHistory[] @relation("LedgerPerformedBy")
  expensesRecorded      BranchExpense[]      @relation("ExpenseRecordedBy")
  payrolls              Payroll[]
  debtLedgerEntries     DebtLedgerEntry[]    @relation("DebtEntryActor")
  bankDepositsUploaded  BankDepositLog[]     @relation("BankDepositUploadedBy")
  bankDepositsVerifiedAsAccountant BankDepositLog[] @relation("BankDepositVerifiedBy")
  depositsRequested     Deposit[]            @relation("DepositDriver")
  depositsAudited       Deposit[]            @relation("DepositAuditedBy")
  posPaymentBundlesLed  PosPaymentBundle[]   @relation("PosPaymentBundleDriver")
  stockMovementsRecorded StockMovement[]     @relation("StockMovementRecordedBy")
  /** Cash "bags" the user received from drivers while acting as Branch Manager. */
  managerCustodyBagsHeld       ManagerCashCustody[] @relation("ManagerCustodyManager")
  /** Cash bags attributed to the user as the source driver (historical, even after handover). */
  managerCustodyBagsHandedOver ManagerCashCustody[] @relation("ManagerCustodyDriver")
  /** Accountant verifications on manager custody bags. */
  managerCustodyVerifications  ManagerCashCustody[] @relation("ManagerCustodyVerifiedBy")
  /** Accountant rejections on manager custody bags. */
  managerCustodyRejections     ManagerCashCustody[] @relation("ManagerCustodyRejectedBy")
  /** Debt transfers where this user is the departing (source) driver. */
  debtTransfersAsSource        DebtTransfer[]       @relation("DebtTransferSource")
  /** Debt transfers where this user is the replacement (target) driver. */
  debtTransfersAsTarget        DebtTransfer[]       @relation("DebtTransferTarget")
  /** Debt transfers initiated by this user (GM or ACCOUNTANT). */
  debtTransfersExecuted        DebtTransfer[]       @relation("DebtTransferExecutor")
  /** Debt transfers cancelled by this user. */
  debtTransfersCancelled       DebtTransfer[]       @relation("DebtTransferCanceller")
  /** Orders whose cash responsibility was transferred FROM this driver (audit only). */
  ordersTransferredFrom        Order[]              @relation("OrderTransferredFromDriver")
}

enum ExpenseCategory {
  SOAP
  FUEL
  MISC
}

enum ExpenseStatus {
  PENDING_ACCOUNTANT
  APPROVED
  REJECTED
  AUDIT
}

/** Field / branch expense funding source — drives wallet vs owner-radar accounting. */
enum ExpenseMethod {
  CASH
  PREPAID_CARD
}

/** Unified append-only ledger (Sales, Expenses, Debts, settlements). */
enum GeneralLedgerEntryType {
  POS_SALE_COMPLETED
  EXPENSE_RECORDED
  WALLET_SETTLEMENT
  DEBT_ADJUSTMENT
}

enum PayrollStatus {
  PENDING
  PAID
}

/** Recurring branch overheads (rent, utilities) — accrued by calendar month in reports. */
enum FixedExpenseCategory {
  RENT
  ELECTRICITY
  LEASE
  OTHER
}

/**
 * V8.5 — Singleton global config for acquirer fees (reporting only).
 * KNET uses flat + % with a selectable rule; card / payment links use %.
 */
enum KnetCommissionRule {
  HIGHER_OF_FLAT_AND_PERCENT
  FLAT_ONLY
  PERCENT_ONLY
}

model PaymentMethodFeeConfig {
  id                   String             @id
  knetFlatKd           Decimal            @default(0.1000) @db.Decimal(19, 4)
  knetPercentOfGross   Decimal            @default(0.015000) @db.Decimal(19, 6)
  knetRule             KnetCommissionRule @default(HIGHER_OF_FLAT_AND_PERCENT)
  cardPercentOfGross   Decimal            @default(0.025000) @db.Decimal(19, 6)
  updatedAt            DateTime           @updatedAt
}

/** Branch operational expenses (manager-recorded); deducted from daily cash in reports. */
model BranchExpense {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  amount           Decimal         @db.Decimal(19, 4)
  category         ExpenseCategory
  expenseMethod    ExpenseMethod   @default(CASH)
  status           ExpenseStatus   @default(PENDING_ACCOUNTANT)
  note             String?
  /** Temporary local/file/data-url receipt pointer until cloud storage is configured. */
  receiptUrl       String?         @db.Text
  recordedById     String          @db.Uuid
  branchId         String?         @db.Uuid
  expenseDate      DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  recordedBy User @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([status])
  @@index([recordedById])
  @@index([branchId])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  phone2    String?
  motherContact String?
  wifeContact   String?
  sonContact    String?
  /** POS / call-center display name when captured. */
  displayName String?
  /** Optional when captured later from the driver’s paperwork. */
  address   String?
  /** Kuwait-style address parts (POS). Composed line also stored in `address` when provided. */
  addressArea    String?
  addressBlock   String?
  addressStreet  String?
  addressAvenue  String?
  addressHouse   String?
  /** Immutable attribution branch set from first transaction/subscription. */
  originBranchId String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originBranch         Branch?  @relation("CustomerOriginBranch", fields: [originBranchId], references: [id], onDelete: SetNull)
  orders              Order[]
  wallet              CustomerWallet?
  transactionHistory  TransactionHistory[]
  debtLedgerEntries   DebtLedgerEntry[]

  @@index([phone])
  @@index([phone2])
  @@index([displayName])
  @@index([originBranchId])
}

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  /** Amount paid by the customer. */
  salePrice     Decimal  @default(0) @db.Decimal(19, 4)
  /** Credit granted to the customer wallet. */
  actualBalance Decimal  @default(0) @db.Decimal(19, 4)
  /** Calendar length of the subscription window from each activation date. */
  validityDays Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriberWallets CustomerWallet[] @relation("WalletSubscriptionPlan")
}

model CustomerWallet {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  /** Prepaid credit the company owes in service value. */
  balance    Decimal  @default(0) @db.Decimal(19, 4)
  /** Amount customer owes beyond wallet (e.g. order exceeded credit). */
  debt       Decimal  @default(0) @db.Decimal(19, 4)
  /** Last subscription activation instant (authoritative window start when set). */
  subscriptionActivatedAt DateTime?
  /** End of the prepaid subscription term (exclusive calendar boundary in UTC date math). */
  subscriptionExpiresAt   DateTime?
  subscriptionPlanId    String?   @db.Uuid
  subscriptionPlanName  String?
  /**
   * Dastur §5 (V1.5) — Call Center subscription-renewal reminders.
   * `subscriptionReminderCount` increments at most once every 24h when
   * the Call Center sends a WhatsApp/SMS nudge; `subscriptionLastReminderAt`
   * is the guard timestamp the backend uses to enforce that window.
   */
  subscriptionReminderCount      Int       @default(0)
  subscriptionLastReminderAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan? @relation("WalletSubscriptionPlan", fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  @@index([subscriptionExpiresAt])
}

model TransactionHistory {
  id              String               @id @default(uuid()) @db.Uuid
  type            LedgerTransactionType
  customerId      String               @db.Uuid
  orderId         String?              @db.Uuid
  /** Primary monetary amount for this line (order total, credit granted, etc.) */
  amount          Decimal              @db.Decimal(19, 4)
  balanceBefore   Decimal              @db.Decimal(19, 4)
  balanceAfter    Decimal              @db.Decimal(19, 4)
  debtBefore      Decimal              @db.Decimal(19, 4)
  debtAfter       Decimal              @db.Decimal(19, 4)
  metadata        Json?
  performedById   String?              @db.Uuid
  createdAt       DateTime             @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  performedBy User?    @relation("LedgerPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId])
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  status         OrderStatus   @default(PENDING)
  serviceType    ServiceType   @default(NORMAL)
  totalPrice     Decimal       @db.Decimal(19, 4)
  cashStatus     CashStatus    @default(UNPAID)
  /** Paper invoice reference when the driver has it; null if not yet recorded. */
  invoiceNumber  String?
  /**
   * Dastur §1 (V1.5) — Human-readable, globally unique order serial
   * composed as `<driverPrefix>-<globalCounter>`. Stamped at creation
   * time when the assigned driver has a `driverPrefix`; legacy rows
   * (and driver-less POS tickets) stay null for backward compatibility.
   */
  serialNumber   String?       @unique
  /**
   * Dastur §5 (V1.5) — Call Center collection reminders counter.
   * Increments at most once every 24h (see `lastReminderAt`).
   */
  reminderCount  Int           @default(0)
  lastReminderAt DateTime?
  notes            String?
  customerId     String        @db.Uuid
  driverId         String?       @db.Uuid
  /** POS checkout: how sale was recognized for reporting (wallet vs external). */
  posPaymentMethod PosPaymentMethod?
  /** Set when the order reaches COMPLETED (for daily sales / GL-style reporting). */
  completedAt      DateTime?
  /** Set when wallet + debt settlement ran for this order (idempotent). */
  walletSettledAt  DateTime?
  /** Multi-invoice POS: single gateway payment for several orders (see PosPaymentBundle). */
  posPaymentBundleId String?     @db.Uuid
  /** Hosted Kuwait Gateway (or dev mock) URL issued at checkout for ONLINE orders. */
  posHostedPaymentUrl String?    @db.Text
  /** Manager cash handover shift that settled this CASH order into office custody. */
  handoverShiftId   String?      @db.Uuid
  /**
   * Dastur §5 — Debt Transfer audit column.
   * When a departing driver's outstanding cash is transferred to a
   * replacement driver, the order's `driverId` is reassigned to the
   * target driver. This column preserves the ORIGINAL driver so
   * historical sales / commission / shift reports can still attribute
   * the work to whoever actually issued the invoice.
   */
  transferredFromDriverId String? @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer           Customer             @relation(fields: [customerId], references: [id])
  driver             User?                @relation("OrderDriver", fields: [driverId], references: [id])
  transferredFromDriver User?             @relation("OrderTransferredFromDriver", fields: [transferredFromDriverId], references: [id], onDelete: SetNull)
  posPaymentBundle   PosPaymentBundle?    @relation(fields: [posPaymentBundleId], references: [id], onDelete: SetNull)
  handoverShift      Shift?               @relation("ShiftHandoverOrders", fields: [handoverShiftId], references: [id], onDelete: SetNull)
  lineItems          OrderLineItem[]
  transactionHistory TransactionHistory[]
  debtLedgerEntries  DebtLedgerEntry[]
  debtTransferLineItems DebtTransferOrder[]

  @@index([driverId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([driverId, cashStatus])
  @@index([completedAt])
  @@index([posPaymentMethod])
  @@index([posPaymentBundleId])
  @@index([handoverShiftId])
  @@index([transferredFromDriverId])
  @@index([serialNumber])
}

/**
 * Dastur §1 (V1.5) — Global atomic counters (e.g. the single-row
 * "ORDER_SERIAL" used to stamp Order.serialNumber). One row per key.
 * Safely incremented inside Prisma transactions via `update({ data:
 * { value: { increment: 1 } } })` which is row-level-locking.
 */
model SerialCounter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/** One hosted payment session for multiple POS orders (same customer, one gateway charge). */
model PosPaymentBundle {
  id            String   @id @default(uuid()) @db.Uuid
  driverId      String   @db.Uuid
  totalAmountKd Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  driver User   @relation("PosPaymentBundleDriver", fields: [driverId], references: [id])
  orders Order[]

  @@index([driverId])
}

model Shift {
  id                   String      @id @default(uuid()) @db.Uuid
  driverId             String      @db.Uuid
  status               ShiftStatus @default(OPEN)
  startedAt            DateTime    @default(now())
  endedAt              DateTime?
  /** Cash amount the manager physically counted (optional audit). */
  declaredHandoverTotal Decimal?   @db.Decimal(19, 4)
  /** Ledger total: orders settled PAID_TO_DRIVER → HANDED_OVER_TO_OFFICE in this handover. */
  systemHandoverTotal   Decimal?   @db.Decimal(19, 4)
  ordersSettledCount    Int?
  /** Bank deposit receipt file path (e.g. /uploads/handover-receipts/...). */
  bankDepositReceiptUrl String?
  confirmedByManagerId  String?    @db.Uuid
  confirmedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  driver               User  @relation("ShiftDriver", fields: [driverId], references: [id])
  confirmedByManager   User? @relation("ShiftConfirmedBy", fields: [confirmedByManagerId], references: [id])
  bankDepositLogs      BankDepositLog[]
  handoverOrders       Order[] @relation("ShiftHandoverOrders")
  managerCustodyBags   ManagerCashCustody[] @relation("ShiftManagerCustody")

  @@index([driverId, status])
}

model BankDepositLog {
  id                     String          @id @default(uuid()) @db.Uuid
  depositType            BankDepositType
  /** Amount (KD) as declared on slip / Z-report for reconciliation. */
  amountKd               Decimal         @db.Decimal(19, 4)
  receiptImageUrl        String
  shiftId                String?         @db.Uuid
  uploadedById           String          @db.Uuid
  verifiedByAccountantId String?        @db.Uuid
  verifiedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  shift                 Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  uploadedBy            User   @relation("BankDepositUploadedBy", fields: [uploadedById], references: [id])
  verifiedByAccountant  User?  @relation("BankDepositVerifiedBy", fields: [verifiedByAccountantId], references: [id])

  @@index([createdAt])
  @@index([uploadedById])
  @@index([verifiedByAccountantId])
}

model Deposit {
  id           String        @id @default(uuid()) @db.Uuid
  driverId     String        @db.Uuid
  amount       Decimal       @db.Decimal(19, 4)
  type         DepositType
  receiptImage String        @db.Text
  status       DepositStatus @default(PENDING)
  auditComment String?
  auditedById  String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  driver    User  @relation("DepositDriver", fields: [driverId], references: [id], onDelete: Cascade)
  auditedBy User? @relation("DepositAuditedBy", fields: [auditedById], references: [id], onDelete: SetNull)

  @@index([driverId, status, createdAt])
  @@index([status, createdAt])
  @@index([auditedById])
}

model OrderLineItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  label      String?
  starchOption StarchOption @default(NONE)
  quantity   Decimal  @db.Decimal(12, 4)
  unitPrice  Decimal  @db.Decimal(19, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DebtLedgerEntry {
  id           String             @id @default(uuid()) @db.Uuid
  customerId   String             @db.Uuid
  orderId      String?            @db.Uuid
  source       DebtSource
  category     DebtEntityCategory
  amount       Decimal            @db.Decimal(19, 4)
  branchId     String?            @db.Uuid
  actorUserId  String?            @db.Uuid
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorUser    User?              @relation("DebtEntryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([source, category, createdAt])
  @@index([orderId])
  @@index([branchId])
}

/** Logical grouping for POS / manager item screens (not a second price source). */
model LaundryItemCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  nameEn    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LaundryPriceListItem[]
}

/** Laundry price list (PDF tariff) — KD per garment × service tier. */
model LaundryPriceListItem {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  nameAr           String
  nameEn           String?
  sortOrder        Int      @default(0)
  /** When true, unit price must be entered manually (list prices are 0). */
  manualEntry      Boolean  @default(false)
  /**
   * Soft-hide switch. Inactive items are excluded from POS / Driver catalogs
   * but remain available in manager admin views so historical pricing / names
   * never mutate under already-issued invoices.
   */
  isActive         Boolean  @default(true)
  priceNormal      Decimal  @db.Decimal(19, 4)
  priceUrgent      Decimal  @db.Decimal(19, 4)
  pricePressOnly   Decimal? @db.Decimal(19, 4)
  priceUrgentPress Decimal? @db.Decimal(19, 4)
  categoryId       String?  @db.Uuid
  category         LaundryItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchOverrides  LaundryBranchItemPrice[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

/**
 * Optional per-branch overrides. Null field = inherit master price from LaundryPriceListItem.
 */
model LaundryBranchItemPrice {
  id                     String   @id @default(uuid()) @db.Uuid
  branchId               String   @db.Uuid
  laundryPriceListItemId String   @db.Uuid
  priceNormal            Decimal? @db.Decimal(19, 4)
  priceUrgent            Decimal? @db.Decimal(19, 4)
  pricePressOnly         Decimal? @db.Decimal(19, 4)
  priceUrgentPress       Decimal? @db.Decimal(19, 4)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  branch Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   LaundryPriceListItem @relation(fields: [laundryPriceListItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, laundryPriceListItemId])
  @@index([branchId])
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  permissions Permission[]
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     Role[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  location  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  expenses              BranchExpense[]
  wallets               Wallet[]
  payrolls              Payroll[]
  fixedExpenseSchedules FixedExpenseSchedule[]
  debtLedgerEntries     DebtLedgerEntry[]
  originCustomers       Customer[] @relation("CustomerOriginBranch")
  laundryBranchPrices   LaundryBranchItemPrice[]
  stockLevels           BranchStockLevel[]
  stockMovements        StockMovement[]
  managerCustodyBags    ManagerCashCustody[] @relation("BranchManagerCustody")
}

model Payroll {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  branchId      String        @db.Uuid
  basicSalary   Decimal       @db.Decimal(19, 4)
  allowances    Decimal       @default(0) @db.Decimal(19, 4)
  deductions    Decimal       @default(0) @db.Decimal(19, 4)
  paymentDate   DateTime
  status        PayrollStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, paymentDate])
  @@index([userId, paymentDate])
  @@index([status])
}

model FixedExpenseSchedule {
  id            String               @id @default(uuid()) @db.Uuid
  branchId      String               @db.Uuid
  title         String
  category      FixedExpenseCategory
  monthlyAmount Decimal              @db.Decimal(19, 4)
  effectiveFrom DateTime             @default(now())
  effectiveTo   DateTime?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([isActive])
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(19, 4)
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  resource  String
  changes   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])
}

model GeneralLedgerEntry {
  id           String                 @id @default(uuid()) @db.Uuid
  entryType    GeneralLedgerEntryType
  amount       Decimal                @db.Decimal(19, 4)
  memo         String?
  metadata     Json?
  customerId   String?                @db.Uuid
  orderId      String?                @db.Uuid
  expenseId    String?                @db.Uuid
  actorUserId  String?                @db.Uuid
  createdAt    DateTime               @default(now())

  @@index([entryType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([orderId])
  @@index([expenseId])
}

// ─── Inventory & Stock (Dastur §4 Smart Inventory) ───────────────────────────
// Owner & Accountant consume the Smart Inventory report; Accountant records
// stock-in movements (Qty / Cost / Supplier). Stock colours (Yellow = low, Red
// = out) are derived on the server from `BranchStockLevel.quantityOnHand` vs
// `reorderPoint` (branch) falling back to `StockItem.reorderPointDefault`.

/** Operational supply category (cleaning, packaging, spare parts, uniforms, …). */
model InventoryCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameAr    String
  nameEn    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items StockItem[]
}

/** External supplier (detergent vendors, parts wholesalers, etc.). */
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
}

/** Master inventory catalog — non-laundry operational supplies. */
model StockItem {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique
  nameAr              String
  nameEn              String?
  /** Unit of measure (pcs, kg, L, box, …). */
  unit                String   @default("pcs")
  categoryId          String?  @db.Uuid
  /** Default reorder threshold for branches without an override. */
  reorderPointDefault Decimal  @default(0) @db.Decimal(19, 4)
  /** Most recent purchase unit cost (KD) — set from the latest STOCK_IN. */
  lastUnitCost        Decimal? @db.Decimal(19, 4)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category     InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchLevels BranchStockLevel[]
  movements    StockMovement[]

  @@index([categoryId])
}

/** Per-branch quantity on hand and optional branch-level reorder override. */
model BranchStockLevel {
  id             String    @id @default(uuid()) @db.Uuid
  branchId       String    @db.Uuid
  stockItemId    String    @db.Uuid
  quantityOnHand Decimal   @default(0) @db.Decimal(19, 4)
  /** Branch override for reorder threshold (null → fall back to item default). */
  reorderPoint   Decimal?  @db.Decimal(19, 4)
  /** Weighted moving-average unit cost, recomputed on every STOCK_IN. */
  avgUnitCost    Decimal?  @db.Decimal(19, 4)
  lastMovementAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, stockItemId])
  @@index([branchId])
  @@index([stockItemId])
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

/**
 * Immutable audit row for every quantity change on a `BranchStockLevel`.
 * Qty is signed (STOCK_IN positive, STOCK_OUT / TRANSFER_OUT negative).
 * `unitCost`/`totalCost` only set for STOCK_IN (purchase) — they drive the
 * running moving-average cost on `BranchStockLevel.avgUnitCost`.
 */
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  stockItemId  String            @db.Uuid
  branchId     String            @db.Uuid
  type         StockMovementType
  quantity     Decimal           @db.Decimal(19, 4)
  unitCost     Decimal?          @db.Decimal(19, 4)
  totalCost    Decimal?          @db.Decimal(19, 4)
  supplierId   String?           @db.Uuid
  recordedById String            @db.Uuid
  /** External reference — PO number, supplier invoice, transfer ticket. */
  reference    String?
  note         String?
  /** Optional uploaded delivery-note / receipt (≤ 1 MB per Dastur §1). */
  receiptUrl   String?           @db.Text
  createdAt    DateTime          @default(now())

  stockItem  StockItem @relation(fields: [stockItemId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recordedBy User      @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])

  @@index([stockItemId])
  @@index([branchId])
  @@index([supplierId])
  @@index([createdAt])
}

/**
 * Dastur §3 — Manager Accountability.
 * One row per "bag" of cash physically received by a Branch Manager from a Driver.
 * - receivedFromDriverAt starts the 24h aging clock.
 * - status drives the aging / verification lifecycle.
 * - depositSlipUrl is the bank deposit slip photo (required to leave PENDING_DEPOSIT).
 * - The Accountant must verify the slip to close custody (→ VERIFIED).
 */
model ManagerCashCustody {
  id                     String                   @id @default(uuid()) @db.Uuid
  managerId              String                   @db.Uuid
  driverId               String                   @db.Uuid
  branchId               String?                  @db.Uuid
  /** Closed handover shift that produced this bag. */
  shiftId                String?                  @db.Uuid
  /** Cash amount handed over from driver to manager (KWD). */
  amountKd               Decimal                  @db.Decimal(19, 4)
  settledOrderCount      Int                      @default(0)
  status                 ManagerCashCustodyStatus @default(PENDING_DEPOSIT)
  /** Aging clock starts here. */
  receivedFromDriverAt   DateTime                 @default(now())
  slipUploadedAt         DateTime?
  depositSlipUrl         String?                  @db.Text
  verifiedByAccountantId String?                  @db.Uuid
  verifiedAt             DateTime?
  rejectedByAccountantId String?                  @db.Uuid
  rejectedAt             DateTime?
  rejectionReason        String?
  note                   String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  manager              User    @relation("ManagerCustodyManager", fields: [managerId], references: [id], onDelete: Restrict)
  driver               User    @relation("ManagerCustodyDriver", fields: [driverId], references: [id], onDelete: Restrict)
  branch               Branch? @relation("BranchManagerCustody", fields: [branchId], references: [id], onDelete: SetNull)
  shift                Shift?  @relation("ShiftManagerCustody", fields: [shiftId], references: [id], onDelete: SetNull)
  verifiedByAccountant User?   @relation("ManagerCustodyVerifiedBy", fields: [verifiedByAccountantId], references: [id], onDelete: SetNull)
  rejectedByAccountant User?   @relation("ManagerCustodyRejectedBy", fields: [rejectedByAccountantId], references: [id], onDelete: SetNull)

  @@index([managerId, status])
  @@index([status, receivedFromDriverAt])
  @@index([branchId])
  @@index([shiftId])
  @@index([driverId])
}

/**
 * Dastur §5 — Debt Transfer document.
 *
 * When a driver departs with outstanding cash custody (orders whose
 * cashStatus is still PAID_TO_DRIVER), GM or ACCOUNTANT can transfer
 * that responsibility to a replacement driver. The transfer is a
 * formal document that requires:
 *   1. GM / ACCOUNTANT initiates with source, target, and order list.
 *   2. Status moves to AWAITING_SIGNATURES.
 *   3. Source driver signs (digital acknowledgement of release).
 *   4. Target driver signs (digital acceptance of debt).
 *   5. Finalize: orders are reassigned (driverId = target, with
 *      transferredFromDriverId preserved), and a pair of
 *      DEBT_ADJUSTMENT GL entries records the ledger effect.
 *
 * OWNER has READ-ONLY access (reports + filtering only — cannot
 * initiate, sign, finalize, or cancel).
 */
model DebtTransfer {
  id              String             @id @default(uuid()) @db.Uuid
  sourceDriverId  String             @db.Uuid
  targetDriverId  String             @db.Uuid
  totalAmount     Decimal            @db.Decimal(19, 4)
  orderCount      Int                @default(0)
  reason          String?            @db.Text
  notes           String?            @db.Text
  status          DebtTransferStatus @default(DRAFT)
  executedById    String             @db.Uuid
  executedByRole  SafariRole
  sourceSignedAt  DateTime?
  targetSignedAt  DateTime?
  finalizedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?            @db.Text
  cancelledById   String?            @db.Uuid
  /** Opaque server-generated signature token printed on the receipt for tamper detection. */
  systemSignature String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  sourceDriver User                @relation("DebtTransferSource",    fields: [sourceDriverId], references: [id], onDelete: Restrict)
  targetDriver User                @relation("DebtTransferTarget",    fields: [targetDriverId], references: [id], onDelete: Restrict)
  executedBy   User                @relation("DebtTransferExecutor",  fields: [executedById],   references: [id], onDelete: Restrict)
  cancelledBy  User?               @relation("DebtTransferCanceller", fields: [cancelledById],  references: [id], onDelete: SetNull)
  orders       DebtTransferOrder[]

  @@index([sourceDriverId, createdAt])
  @@index([targetDriverId, createdAt])
  @@index([status, createdAt])
  @@index([executedById, createdAt])
  @@index([createdAt])
}

/** Line item: a single order included in a debt-transfer document. */
model DebtTransferOrder {
  id             String   @id @default(uuid()) @db.Uuid
  debtTransferId String   @db.Uuid
  orderId        String   @db.Uuid
  /** Snapshot of the order's receivable at inclusion time (KWD). */
  amountSnapshot Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now())

  debtTransfer DebtTransfer @relation(fields: [debtTransferId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([debtTransferId])
  @@index([orderId])
}
