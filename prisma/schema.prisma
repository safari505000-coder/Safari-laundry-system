// Safari Fast Group — PostgreSQL schema (UUID PKs). Migrations not applied yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/** Institutional roles — enforced in app, permissions, and JWT guards. */
enum SafariRole {
  OWNER
  MANAGER
  DRIVER
  WORKER
  CALL_CENTER
  ACCOUNTANT
  SUPERVISOR
  VIEWER
}

enum OrderStatus {
  PENDING
  PICKED_UP
  IN_PROGRESS
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELED
}

enum ServiceType {
  EXPRESS
  NORMAL
}

/** Cash custody for completed COD-style orders. */
enum CashStatus {
  UNPAID
  PAID_TO_DRIVER
  HANDED_OVER_TO_OFFICE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum LedgerTransactionType {
  SUBSCRIPTION_ACTIVATION
  ORDER_WALLET_SETTLEMENT
}

/** POS / daily sales — how the non-wallet portion was collected (if any). */
enum PosPaymentMethod {
  SUBSCRIPTION_WALLET
  CASH
  KNET
  PAYMENT_LINK
  DEBT_ON_ACCOUNT
  ONLINE
}

enum StarchOption {
  NONE
  STARCH_25
}

enum DebtSource {
  SUBSCRIPTION_OVERUSE
  INVOICE_SHORTFALL
}

enum DebtEntityCategory {
  BRANCH
  DRIVER
  OWNER
  CALL_CENTER
}

/** Manager shift-end bank paperwork for accountant reconciliation. */
enum BankDepositType {
  CASH_DEPOSIT_SLIP
  KNET_Z_REPORT
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  /** Unique login handle (staff ID / username). */
  username    String     @unique
  password    String
  fullName    String
  /** Legacy corporate employee number (optional). */
  employeeId  String?    @unique
  /** Legacy job title (optional). */
  jobTitle    String?
  phone       String?    @unique
  safariRole  SafariRole @default(DRIVER)
  /** Owner toggle: inactive users cannot sign in. */
  isActive    Boolean    @default(true)
  roleId      String     @db.Uuid
  branchId    String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  role           Role     @relation(fields: [roleId], references: [id])
  branch         Branch?  @relation(fields: [branchId], references: [id])
  auditLogs          AuditLog[]
  ordersAsDriver     Order[]  @relation("OrderDriver")
  shiftsAsDriver        Shift[]             @relation("ShiftDriver")
  shiftConfirmations    Shift[]             @relation("ShiftConfirmedBy")
  ledgerTransactions    TransactionHistory[] @relation("LedgerPerformedBy")
  expensesRecorded      BranchExpense[]      @relation("ExpenseRecordedBy")
  payrolls              Payroll[]
  debtLedgerEntries     DebtLedgerEntry[]    @relation("DebtEntryActor")
  bankDepositsUploaded  BankDepositLog[]     @relation("BankDepositUploadedBy")
  bankDepositsVerifiedAsAccountant BankDepositLog[] @relation("BankDepositVerifiedBy")
  posPaymentBundlesLed  PosPaymentBundle[]   @relation("PosPaymentBundleDriver")
}

enum ExpenseCategory {
  SOAP
  FUEL
  MISC
}

enum ExpenseStatus {
  PENDING_ACCOUNTANT
  APPROVED
  REJECTED
  AUDIT
}

enum PayrollStatus {
  PENDING
  PAID
}

/** Recurring branch overheads (rent, utilities) — accrued by calendar month in reports. */
enum FixedExpenseCategory {
  RENT
  ELECTRICITY
  LEASE
  OTHER
}

/** Branch operational expenses (manager-recorded); deducted from daily cash in reports. */
model BranchExpense {
  id               String          @id @default(uuid()) @db.Uuid
  title            String
  amount           Decimal         @db.Decimal(19, 4)
  category         ExpenseCategory
  status           ExpenseStatus   @default(PENDING_ACCOUNTANT)
  note             String?
  /** Temporary local/file/data-url receipt pointer until cloud storage is configured. */
  receiptUrl       String?         @db.Text
  recordedById     String          @db.Uuid
  branchId         String?         @db.Uuid
  expenseDate      DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  recordedBy User @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([status])
  @@index([recordedById])
  @@index([branchId])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  phone2    String?
  motherContact String?
  wifeContact   String?
  sonContact    String?
  /** POS / call-center display name when captured. */
  displayName String?
  /** Optional when captured later from the driver’s paperwork. */
  address   String?
  /** Kuwait-style address parts (POS). Composed line also stored in `address` when provided. */
  addressArea    String?
  addressBlock   String?
  addressStreet  String?
  addressAvenue  String?
  addressHouse   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders              Order[]
  wallet              CustomerWallet?
  transactionHistory  TransactionHistory[]
  debtLedgerEntries   DebtLedgerEntry[]

  @@index([phone])
  @@index([phone2])
}

model SubscriptionPlan {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  price         Decimal  @db.Decimal(19, 4)
  creditAmount  Decimal  @db.Decimal(19, 4)
  /** Calendar length of the subscription window from each activation date. */
  validityDays Int      @default(30)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriberWallets CustomerWallet[] @relation("WalletSubscriptionPlan")
}

model CustomerWallet {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @db.Uuid
  /** Prepaid credit the company owes in service value. */
  balance    Decimal  @default(0) @db.Decimal(19, 4)
  /** Amount customer owes beyond wallet (e.g. order exceeded credit). */
  debt       Decimal  @default(0) @db.Decimal(19, 4)
  /** Last subscription activation instant (authoritative window start when set). */
  subscriptionActivatedAt DateTime?
  /** End of the prepaid subscription term (exclusive calendar boundary in UTC date math). */
  subscriptionExpiresAt   DateTime?
  subscriptionPlanId    String?   @db.Uuid
  subscriptionPlanName  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan? @relation("WalletSubscriptionPlan", fields: [subscriptionPlanId], references: [id], onDelete: SetNull)

  @@index([subscriptionExpiresAt])
}

model TransactionHistory {
  id              String               @id @default(uuid()) @db.Uuid
  type            LedgerTransactionType
  customerId      String               @db.Uuid
  orderId         String?              @db.Uuid
  /** Primary monetary amount for this line (order total, credit granted, etc.) */
  amount          Decimal              @db.Decimal(19, 4)
  balanceBefore   Decimal              @db.Decimal(19, 4)
  balanceAfter    Decimal              @db.Decimal(19, 4)
  debtBefore      Decimal              @db.Decimal(19, 4)
  debtAfter       Decimal              @db.Decimal(19, 4)
  metadata        Json?
  performedById   String?              @db.Uuid
  createdAt       DateTime             @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  performedBy User?    @relation("LedgerPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId])
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  status         OrderStatus   @default(PENDING)
  serviceType    ServiceType   @default(NORMAL)
  totalPrice     Decimal       @db.Decimal(19, 4)
  cashStatus     CashStatus    @default(UNPAID)
  /** Paper invoice reference when the driver has it; null if not yet recorded. */
  invoiceNumber  String?
  notes            String?
  customerId     String        @db.Uuid
  driverId         String?       @db.Uuid
  /** POS checkout: how sale was recognized for reporting (wallet vs external). */
  posPaymentMethod PosPaymentMethod?
  /** Set when the order reaches COMPLETED (for daily sales / GL-style reporting). */
  completedAt      DateTime?
  /** Set when wallet + debt settlement ran for this order (idempotent). */
  walletSettledAt  DateTime?
  /** Multi-invoice POS: single gateway payment for several orders (see PosPaymentBundle). */
  posPaymentBundleId String?     @db.Uuid
  /** Hosted Kuwait Gateway (or dev mock) URL issued at checkout for ONLINE orders. */
  posHostedPaymentUrl String?    @db.Text
  /** Manager cash handover shift that settled this CASH order into office custody. */
  handoverShiftId   String?      @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer           Customer             @relation(fields: [customerId], references: [id])
  driver             User?                @relation("OrderDriver", fields: [driverId], references: [id])
  posPaymentBundle   PosPaymentBundle?    @relation(fields: [posPaymentBundleId], references: [id], onDelete: SetNull)
  handoverShift      Shift?               @relation("ShiftHandoverOrders", fields: [handoverShiftId], references: [id], onDelete: SetNull)
  lineItems          OrderLineItem[]
  transactionHistory TransactionHistory[]
  debtLedgerEntries  DebtLedgerEntry[]

  @@index([driverId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([driverId, cashStatus])
  @@index([completedAt])
  @@index([posPaymentMethod])
  @@index([posPaymentBundleId])
  @@index([handoverShiftId])
}

/** One hosted payment session for multiple POS orders (same customer, one gateway charge). */
model PosPaymentBundle {
  id            String   @id @default(uuid()) @db.Uuid
  driverId      String   @db.Uuid
  totalAmountKd Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  driver User   @relation("PosPaymentBundleDriver", fields: [driverId], references: [id])
  orders Order[]

  @@index([driverId])
}

model Shift {
  id                   String      @id @default(uuid()) @db.Uuid
  driverId             String      @db.Uuid
  status               ShiftStatus @default(OPEN)
  startedAt            DateTime    @default(now())
  endedAt              DateTime?
  /** Cash amount the manager physically counted (optional audit). */
  declaredHandoverTotal Decimal?   @db.Decimal(19, 4)
  /** Ledger total: orders settled PAID_TO_DRIVER → HANDED_OVER_TO_OFFICE in this handover. */
  systemHandoverTotal   Decimal?   @db.Decimal(19, 4)
  ordersSettledCount    Int?
  /** Bank deposit receipt file path (e.g. /uploads/handover-receipts/...). */
  bankDepositReceiptUrl String?
  confirmedByManagerId  String?    @db.Uuid
  confirmedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  driver               User  @relation("ShiftDriver", fields: [driverId], references: [id])
  confirmedByManager   User? @relation("ShiftConfirmedBy", fields: [confirmedByManagerId], references: [id])
  bankDepositLogs      BankDepositLog[]
  handoverOrders       Order[] @relation("ShiftHandoverOrders")

  @@index([driverId, status])
}

model BankDepositLog {
  id                     String          @id @default(uuid()) @db.Uuid
  depositType            BankDepositType
  /** Amount (KD) as declared on slip / Z-report for reconciliation. */
  amountKd               Decimal         @db.Decimal(19, 4)
  receiptImageUrl        String
  shiftId                String?         @db.Uuid
  uploadedById           String          @db.Uuid
  verifiedByAccountantId String?        @db.Uuid
  verifiedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  shift                 Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  uploadedBy            User   @relation("BankDepositUploadedBy", fields: [uploadedById], references: [id])
  verifiedByAccountant  User?  @relation("BankDepositVerifiedBy", fields: [verifiedByAccountantId], references: [id])

  @@index([createdAt])
  @@index([uploadedById])
  @@index([verifiedByAccountantId])
}

model OrderLineItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  label      String?
  starchOption StarchOption @default(NONE)
  quantity   Decimal  @db.Decimal(12, 4)
  unitPrice  Decimal  @db.Decimal(19, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model DebtLedgerEntry {
  id           String             @id @default(uuid()) @db.Uuid
  customerId   String             @db.Uuid
  orderId      String?            @db.Uuid
  source       DebtSource
  category     DebtEntityCategory
  amount       Decimal            @db.Decimal(19, 4)
  branchId     String?            @db.Uuid
  actorUserId  String?            @db.Uuid
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorUser    User?              @relation("DebtEntryActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([source, category, createdAt])
  @@index([orderId])
  @@index([branchId])
}

/** Laundry price list (PDF tariff) — KD per garment × service tier. */
model LaundryPriceListItem {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  nameAr           String
  nameEn           String?
  sortOrder        Int      @default(0)
  /** When true, unit price must be entered manually (list prices are 0). */
  manualEntry      Boolean  @default(false)
  priceNormal      Decimal  @db.Decimal(19, 4)
  priceUrgent      Decimal  @db.Decimal(19, 4)
  pricePressOnly   Decimal? @db.Decimal(19, 4)
  priceUrgentPress Decimal? @db.Decimal(19, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  permissions Permission[]
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     Role[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  location  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  expenses              BranchExpense[]
  wallets               Wallet[]
  payrolls              Payroll[]
  fixedExpenseSchedules FixedExpenseSchedule[]
  debtLedgerEntries     DebtLedgerEntry[]
}

model Payroll {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  branchId      String        @db.Uuid
  basicSalary   Decimal       @db.Decimal(19, 4)
  allowances    Decimal       @default(0) @db.Decimal(19, 4)
  deductions    Decimal       @default(0) @db.Decimal(19, 4)
  paymentDate   DateTime
  status        PayrollStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId, paymentDate])
  @@index([userId, paymentDate])
  @@index([status])
}

model FixedExpenseSchedule {
  id            String               @id @default(uuid()) @db.Uuid
  branchId      String               @db.Uuid
  title         String
  category      FixedExpenseCategory
  monthlyAmount Decimal              @db.Decimal(19, 4)
  effectiveFrom DateTime             @default(now())
  effectiveTo   DateTime?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([isActive])
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(19, 4)
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  resource  String
  changes   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])
}
