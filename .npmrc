# Render/CI safety: never block `npm install` on engine version mismatches.
# Our `.node-version` (22.12.0) still tells Render the *preferred* runtime;
# this only relaxes the install-time gate so builds don't die on edge-case
# transitive-dep engines fields.
engine-strict=false

# Deterministic, non-interactive installs in CI.
fund=false
audit=false
